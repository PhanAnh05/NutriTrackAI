@model WeightLogIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Nhật ký Cân nặng & Tiến trình";
    var needsWeightConfirmation = ViewData.ModelState.TryGetValue("Form.ConfirmLargeWeightChange", out var confirmation)
        && confirmation.Errors.Count > 0;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var historyPage = Model.CurrentPage > 1 ? (int?)Model.CurrentPage : null;
    ViewData["WeightHistoryPage"] = historyPage;
}

<div class="container py-5">
    <!-- Success / Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model.WeightMismatch is not null)
    {
        <partial name="_WeightMismatchBanner" model="Model.WeightMismatch" />
    }

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge badge-custom-emerald mb-2">Theo dõi chỉ số cơ thể</span>
            <h2 class="fw-bold text-dark mb-1">Nhật Ký Cân Nặng</h2>
            <p class="text-muted small mb-0">Ghi lại chỉ số cân nặng thường xuyên để theo dõi tiến trình giảm mỡ / tăng cơ.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Goal" asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-bullseye me-1"></i> Xem mục tiêu
            </a>
        </div>
    </div>

    <!-- 4 Stats Cards Row -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border shadow-sm h-100">
                <small class="text-muted d-block mb-1">Cân nặng hiện tại</small>
                <h3 class="fw-bold text-success mb-1">@Model.CurrentWeight.ToString("0.0") kg</h3>
                <span class="badge @Model.BmiBadgeClass">BMI: @Model.Bmi.ToString("0.0") - @Model.BmiCategory</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border shadow-sm h-100">
                <small class="text-muted d-block mb-1">Cân nặng mục tiêu</small>
                <h3 class="fw-bold text-primary mb-1">@(Model.TargetWeight.HasValue ? Model.TargetWeight.Value.ToString("0.0") + " kg" : "--")</h3>
                <small class="text-muted">Đích cần đạt</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border shadow-sm h-100">
                <small class="text-muted d-block mb-1">Cân nặng bắt đầu</small>
                <h3 class="fw-bold text-dark mb-1">@(Model.StartWeight.HasValue ? Model.StartWeight.Value.ToString("0.0") + " kg" : "--")</h3>
                <small class="text-muted">Mốc khởi điểm</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3 border shadow-sm h-100">
                <small class="text-muted d-block mb-1">Tổng biến động</small>
                <h3 class="fw-bold @(Model.WeightChange <= 0 ? "text-success" : "text-danger") mb-1">
                    @(Model.WeightChange > 0 ? "+" : "")@Model.WeightChange.ToString("0.0") kg
                </h3>
                <small class="text-muted">So với bản ghi đầu</small>
            </div>
        </div>
    </div>

    <!-- Main Content: Form & Chart -->
    <div class="row g-4 mb-5">
        <!-- Form Ghi nhận cân nặng -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 border-0 shadow h-100">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-pencil-square text-success me-2"></i><span id="weightFormHeading">@(Model.Form.Id > 0 ? "Sửa bản ghi cân nặng" : "Ghi nhận hôm nay")</span>
                </h5>
                <form asp-action="Save" asp-route-page="@historyPage" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Form.Id" id="formLogId" />

                    <!-- Ngày ghi nhận -->
                    <div class="mb-3">
                        <label asp-for="Form.LoggedOn" for="formLoggedOn" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Form.LoggedOn" class="form-control" type="date" id="formLoggedOn"
                               data-business-date="weightBusinessDate" aria-describedby="weightBusinessDate" />
                        <output id="weightBusinessDate" for="formLoggedOn" class="d-block text-muted small mt-1">@vi.TextInfo.ToTitleCase(Model.Form.LoggedOn.ToString("dddd, dd/MM/yyyy", vi))</output>
                        <span asp-validation-for="Form.LoggedOn" class="text-danger small"></span>
                    </div>

                    <!-- Cân nặng -->
                    <div class="mb-3">
                        <label asp-for="Form.WeightKg" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <input asp-for="Form.WeightKg" class="form-control fs-5 fw-bold text-success" type="number" step="0.1" min="20" max="300" id="formWeightKg" />
                            <span class="input-group-text bg-light">kg</span>
                        </div>
                        <span asp-validation-for="Form.WeightKg" class="text-danger small"></span>
                    </div>

                    @if (needsWeightConfirmation)
                    {
                        <div id="weightConfirmation" class="alert alert-warning mb-3" role="group" aria-labelledby="weightConfirmationLabel">
                            <span asp-validation-for="Form.ConfirmLargeWeightChange" id="weightConfirmationMessage" class="d-block mb-2"></span>
                            <div class="form-check">
                                <input asp-for="Form.ConfirmLargeWeightChange" class="form-check-input" aria-describedby="weightConfirmationMessage" />
                                <label asp-for="Form.ConfirmLargeWeightChange" id="weightConfirmationLabel" class="form-check-label">Tôi xác nhận cân nặng này là đúng.</label>
                            </div>
                            @if (Model.Form.PhotoFile is not null)
                            {
                                <p class="small mb-0 mt-2">Chọn lại ảnh tiến độ nếu bạn muốn tải ảnh lên khi lưu.</p>
                            }
                        </div>
                    }

                    <!-- Ghi chú -->
                    <div class="mb-3">
                        <label asp-for="Form.Note" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Form.Note" class="form-control" rows="2" placeholder="Ví dụ: Cân vào buổi sáng sau khi ngủ dậy và đi vệ sinh..." id="formNote"></textarea>
                    </div>

                    <!-- Ảnh tiến độ -->
                    <div class="mb-4">
                        <label asp-for="Form.PhotoFile" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Form.PhotoFile" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Chỉ nhận .jpg, .png, .webp (&le; 5MB).</small>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2">
                        <i class="bi bi-save me-1"></i> Lưu Cân Nặng
                    </button>
                    <button type="button" class="btn btn-outline-secondary w-100 py-1 mt-2 @(Model.Form.Id > 0 ? "" : "d-none")" id="btnCancelEdit" onclick="resetForm()">
                        Hủy chế độ sửa
                    </button>
                </form>
            </div>
        </div>

        <!-- Biểu đồ Chart.js -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 border-0 shadow h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-graph-up text-success me-2"></i>Tiến trình cân nặng theo thời gian
                    </h5>
                </div>
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="weightProgressChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Lịch sử Cân nặng -->
    <div class="card card-custom p-4 border-0 shadow-sm">
        <h5 class="fw-bold text-dark mb-3">Lịch sử ghi nhận chi tiết</h5>
        @if (Model.Logs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th>Ngày ghi nhận</th>
                            <th>Cân nặng (kg)</th>
                            <th>Ghi chú</th>
                            <th>Ảnh tiến độ</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@log.LoggedOn.ToString("dd/MM/yyyy")</strong>
                                    <small class="text-muted d-block">@log.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <span class="fs-5 fw-bold text-success">@log.WeightKg.ToString("0.0")</span> kg
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(log.Note) ? "--" : log.Note)
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.PhotoUrl))
                                    {
                                        <a href="@log.PhotoUrl" target="_blank">
                                            <img src="@log.PhotoUrl" alt="Progress Photo" class="rounded border shadow-sm" style="width: 44px; height: 44px; object-fit: cover;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" aria-label="Sửa bản ghi ngày @log.LoggedOn.ToString("dd/MM/yyyy")"
                                            data-log-id="@log.Id" data-log-date="@log.LoggedOn.ToString("yyyy-MM-dd")"
                                            data-log-weight="@log.WeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-log-note="@log.Note"
                                            onclick="editLog(this.dataset)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@log.Id" asp-route-page="@historyPage" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản ghi cân nặng ngày @log.LoggedOn.ToString("dd/MM/yyyy")?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang lịch sử cân nặng" class="mt-3">
                    <ul class="pagination justify-content-center flex-wrap mb-0">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Trang trước">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @for (int pageNumber = Math.Max(1, Model.CurrentPage - 2); pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); pageNumber++)
                        {
                            if (pageNumber == Model.CurrentPage)
                            {
                                <li class="page-item active"><span class="page-link" aria-current="page">@pageNumber</span></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a></li>
                            }
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Trang tiếp theo">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <p class="text-muted small mb-0">Chưa có bản ghi cân nặng nào.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDates));
        const chartWeights = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartWeights));
        const chartTargets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartTargets));

        const ctx = document.getElementById('weightProgressChart').getContext('2d');
        const weightChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Cân nặng thực tế (kg)',
                        data: chartWeights,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Mục tiêu (kg)',
                        data: chartTargets,
                        borderColor: '#94a3b8',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 0,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            font: { family: 'system-ui', size: 12 }
                        }
                    },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        padding: 10,
                        cornerRadius: 8,
                        titleFont: { size: 13, weight: 'bold' },
                        bodyFont: { size: 13 }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false }
                    },
                    y: {
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function(value) { return value + ' kg'; }
                        }
                    }
                }
            }
        });

        function editLog(log) {
            clearWeightConfirmation();
            document.getElementById("formLogId").value = log.logId;
            setWeightFormDate(log.logDate);
            document.getElementById("formWeightKg").value = log.logWeight;
            document.getElementById("formNote").value = log.logNote ?? '';
            document.getElementById("weightFormHeading").textContent = "Sửa bản ghi cân nặng";
            document.getElementById("btnCancelEdit").classList.remove("d-none");
            window.scrollTo({ top: 300, behavior: 'smooth' });
        }

        function resetForm() {
            clearWeightConfirmation();
            document.getElementById("formLogId").value = 0;
            setWeightFormDate('@GoalPolicy.Today.ToString("yyyy-MM-dd")');
            document.getElementById("formWeightKg").value = '@Model.CurrentWeight.ToString(System.Globalization.CultureInfo.InvariantCulture)';
            document.getElementById("formNote").value = '';
            document.getElementById("weightFormHeading").textContent = "Ghi nhận hôm nay";
            document.getElementById("btnCancelEdit").classList.add("d-none");
        }

        function setWeightFormDate(date) {
            const dateInput = document.getElementById("formLoggedOn");
            dateInput.value = date;
            dateInput.dispatchEvent(new Event("input", { bubbles: true }));
        }

        function clearWeightConfirmation() {
            const confirmation = document.getElementById("weightConfirmation");
            if (confirmation) {
                confirmation.querySelector("input[type=checkbox]").checked = false;
                confirmation.hidden = true;
            }
        }

        document.getElementById("formLoggedOn").addEventListener("change", clearWeightConfirmation);
        document.getElementById("formWeightKg").addEventListener("input", clearWeightConfirmation);
    </script>
}
