@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ sức khỏe cá nhân";
    var statusMessage = Model.StatusMessage ?? TempData["SuccessMessage"] as string;
    var needsWeightConfirmation = ViewData.ModelState.TryGetValue(nameof(Model.ConfirmLargeWeightChange), out var confirmation)
        && confirmation.Errors.Count > 0;
}

<div class="container py-5">
    <!-- Success Alert -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @statusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger mb-4" role="alert">@errorMessage</div>
    }
    @if (Model.WeightMismatch is not null)
    {
        <partial name="_WeightMismatchBanner" model="Model.WeightMismatch" />
    }

    <!-- Top User Overview Card -->
    <div class="card card-custom p-4 mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);">
        <div class="d-flex flex-column flex-md-row align-items-center gap-4">
            <div class="position-relative">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle border border-3 border-success shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle border border-3 border-success shadow-sm d-flex align-items-center justify-content-center bg-white text-success" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
            </div>
            <div class="text-center text-md-start flex-grow-1">
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                    <h3 class="fw-bold text-dark mb-0">@Model.FullName</h3>
                    <span class="badge @Model.BmiBadgeClass" title="@GoalPolicy.AdultBmiReference">BMI: @Model.Bmi.ToString("0.0") - @Model.BmiCategory</span>
                </div>
                <p class="text-muted small mb-3"><i class="bi bi-envelope me-1"></i>@Model.Email • Tuổi: <strong>@Model.Age</strong></p>
                
                <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-arrows-vertical text-success me-1"></i>Cao: <strong>@Model.HeightCm.ToString("0.0") cm</strong>
                    </span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-speedometer text-success me-1"></i>Hiện tại: <strong>@Model.CurrentWeightKg.ToString("0.0") kg</strong>
                    </span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-bullseye text-primary me-1"></i>Mục tiêu: <strong>@Model.TargetWeightKg.ToString("0.0") kg</strong>
                    </span>
                </div>
            </div>

            <!-- Health Metric Box -->
            <div class="d-flex flex-column gap-2 text-center text-md-end">
                <div class="p-3 bg-white rounded-3 border shadow-sm">
                    <small class="text-muted d-block">Calo khuyến nghị</small>
                    <strong class="text-success fs-4">@Model.DailyCalorieTarget.ToString("N0") kcal</strong>
                </div>
                <small class="text-muted">BMR: @Model.Bmr.ToString("N0") kcal | TDEE: @Model.Tdee.ToString("N0") kcal</small>
            </div>
        </div>
    </div>

    <!-- Edit Profile Form -->
    <div class="card card-custom p-4 p-md-5 border-0 shadow">
        <h4 class="fw-bold text-dark mb-3">Cập nhật thông tin hồ sơ sức khỏe</h4>
        <p class="text-muted small mb-4">Các thay đổi sẽ tự động cập nhật lại các chỉ số BMI, BMR và ngân sách calo hằng ngày của bạn.</p>

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

            <div class="row g-4">
                <!-- Cột 1: Thông tin cơ bản & Avatar -->
                <div class="col-lg-6">
                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3">
                        <i class="bi bi-person-badge me-2"></i>Thông tin cá nhân & Ảnh
                    </h5>

                    <!-- Họ tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email (Readonly) -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly disabled />
                    </div>

                    <!-- Upload Avatar -->
                    <div class="mb-3">
                        <label asp-for="AvatarFile" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="AvatarFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Định dạng hỗ trợ: .jpg, .jpeg, .png, .webp (Tối đa 5 MB).</small>
                        <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                    </div>

                    <!-- Giới tính & Ngày sinh -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="Gender" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="@Gender.Male">Nam</option>
                                <option value="@Gender.Female">Nữ</option>
                                <option value="@Gender.Other">Khác</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Chiều cao & Cân nặng -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="HeightCm" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="HeightCm" class="form-control" type="number" step="0.1" min="100" max="250" />
                                <span class="input-group-text bg-light">cm</span>
                            </div>
                            <span asp-validation-for="HeightCm" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CurrentWeightKg" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="CurrentWeightKg" class="form-control" type="number" step="0.1" min="20" max="300" />
                                <span class="input-group-text bg-light">kg</span>
                            </div>
                            <span asp-validation-for="CurrentWeightKg" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (needsWeightConfirmation)
                    {
                        <div class="alert alert-warning mb-3" role="group" aria-labelledby="profileWeightConfirmationLabel">
                            <span asp-validation-for="ConfirmLargeWeightChange" id="profileWeightConfirmationMessage" class="d-block mb-2"></span>
                            <div class="form-check">
                                <input asp-for="ConfirmLargeWeightChange" class="form-check-input" aria-describedby="profileWeightConfirmationMessage" />
                                <label asp-for="ConfirmLargeWeightChange" id="profileWeightConfirmationLabel" class="form-check-label">Tôi xác nhận cân nặng này là đúng.</label>
                            </div>
                            @if (Model.AvatarFile is not null)
                            {
                                <p class="small mb-0 mt-2">Chọn lại ảnh đại diện nếu bạn muốn tải ảnh lên khi lưu.</p>
                            }
                        </div>
                    }

                    <!-- Cân nặng mong muốn & Mục tiêu nước -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="TargetWeightKg" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="TargetWeightKg" readonly="@(Model.HasActiveGoal ? "readonly" : null)" class="form-control" type="number" step="0.1" min="20" max="300" />
                                <span class="input-group-text bg-light">kg</span>
                            </div>
                            <span asp-validation-for="TargetWeightKg" class="text-danger small"></span>
                            @if (Model.HasActiveGoal) { <small>Đang theo mục tiêu có hiệu lực. <a asp-controller="Goal" asp-action="Create">Thiết lập mục tiêu mới</a></small> }
                        </div>
                        <div class="col-6">
                            <label asp-for="DailyWaterGoalMl" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="DailyWaterGoalMl" class="form-control" type="number" step="50" min="500" max="10000" />
                                <span class="input-group-text bg-light">ml</span>
                            </div>
                            <span asp-validation-for="DailyWaterGoalMl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Cột 2: Thói quen, Dị ứng & Sức khỏe -->
                <div class="col-lg-6">
                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3">
                        <i class="bi bi-heart-pulse me-2"></i>Chế độ ăn & Lối sống
                    </h5>

                    <!-- Mức độ vận động -->
                    <div class="mb-3">
                        <label asp-for="ActivityLevel" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="ActivityLevel" class="form-select">
                            <option value="@ActivityLevel.Sedentary">Ít vận động (Hệ số 1.2)</option>
                            <option value="@ActivityLevel.Light">Vận động nhẹ (1-3 buổi/tuần - Hệ số 1.375)</option>
                            <option value="@ActivityLevel.Moderate">Vận động vừa phải (3-5 buổi/tuần - Hệ số 1.55)</option>
                            <option value="@ActivityLevel.Active">Vận động nhiều (6-7 buổi/tuần - Hệ số 1.725)</option>
                            <option value="@ActivityLevel.VeryActive">Vận động rất nhiều (VĐV - Hệ số 1.9)</option>
                        </select>
                    </div>

                    <!-- Chế độ ăn -->
                    <div class="mb-3">
                        <label asp-for="DietType" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="DietType" class="form-select">
                            @foreach (var diet in Enum.GetValues<DietType>())
                            {
                                <option value="@diet">@diet.GetVietnameseLabel()</option>
                            }
                        </select>
                    </div>

                    <!-- Dị ứng thực phẩm -->
                    <div class="mb-3">
                        <label asp-for="Allergies" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Allergies" class="form-control" placeholder="Ví dụ: tôm, đậu phộng, hải sản, sữa, trứng" />
                        <small class="text-muted">Các món chứa nguyên liệu này sẽ tự động bị loại bỏ khỏi thực đơn gợi ý.</small>
                    </div>

                    <!-- Món không thích -->
                    <div class="mb-3">
                        <label asp-for="DislikedFoods" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="DislikedFoods" class="form-control" placeholder="Ví dụ: hành tây, khổ qua" />
                    </div>

                    <!-- Ghi chú sức khỏe -->
                    <div class="mb-3">
                        <label asp-for="HealthNotes" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="HealthNotes" class="form-control" rows="3" placeholder="Ghi chú thêm về sở thích hoặc tình trạng sức khỏe cần lưu ý..."></textarea>
                        <p class="form-text">@GoalPolicy.HealthNotesHelp</p>
                    </div>
                </div>
            </div>

            @Html.EditorFor(model => model.Screening)
            @if (Model.Health is { NeedsScreening: true, SuspensionReason: null })
            {
                <p class="small text-muted">@GoalPolicy.HealthScreeningPrompt</p>
            }
            else if (Model.Health is { SuspensionReason: null, Reasons.Count: > 0 } health)
            {
                <p class="small text-warning-emphasis">@string.Join(". ", health.Reasons)</p>
            }
            @if (Model.Health?.Constraints.SoyMedicationTiming == true) { <p class="small text-muted">@GoalPolicy.SoyTimingNote</p> }
            @if (Model.Health?.Constraints.WaterPerDoctor == true) { <p class="small text-muted">@GoalPolicy.WaterPerDoctorNote</p> }
            @if (Model.PlanRestrictionMessage != null)
            {
                <p class="alert alert-warning" role="status">@Model.PlanRestrictionMessage</p>
            }
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-custom px-4">
                    <i class="bi bi-x-circle me-1"></i> Hủy
                </a>
                <button type="submit" class="btn btn-primary-custom px-5">
                    <i class="bi bi-check-lg me-1"></i> Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/health-screening.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (needsWeightConfirmation)
    {
        <script>
            const profileWeightInput = document.getElementById("CurrentWeightKg");
            const profileWeightConfirmation = document.getElementById("ConfirmLargeWeightChange");
            profileWeightInput.addEventListener("input", () => { profileWeightConfirmation.checked = false; });
        </script>
    }
}
