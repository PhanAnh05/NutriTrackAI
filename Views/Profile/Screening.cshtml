@model HealthScreeningPageViewModel
@{
    ViewData["Title"] = "Cập nhật sàng lọc sức khỏe";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index", "Dashboard");
}
<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card card-custom p-3 p-md-4">
                <h1 class="h3 fw-bold mb-3">Cập nhật sàng lọc sức khỏe</h1>
                <form asp-action="Screening" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    @Html.EditorFor(model => model.Screening)
                    <div class="d-flex flex-wrap gap-2 justify-content-between">
                        <a href="@backUrl" class="btn btn-outline-custom">Quay lại</a>
                        <button class="btn btn-primary-custom" type="submit">Lưu sàng lọc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/health-screening.js" asp-append-version="true"></script>
}
