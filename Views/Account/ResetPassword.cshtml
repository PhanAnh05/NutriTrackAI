@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card card-custom p-4 p-md-5 border-0 shadow">
                <div class="text-center mb-4">
                    <span class="brand-icon mb-3 bg-primary-subtle text-primary"><i class="bi bi-shield-lock-fill"></i></span>
                    <h3 class="fw-bold text-dark">Đặt lại mật khẩu</h3>
                    <p class="text-muted small">Thiết lập mật khẩu mới an toàn cho tài khoản của bạn</p>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tài khoản Email</label>
                        <input class="form-control bg-light" value="@Model.Email" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 8 ký tự, có chữ và số" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6">
                        <i class="bi bi-check2-circle me-1"></i> Lưu Mật Khẩu Mới
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
