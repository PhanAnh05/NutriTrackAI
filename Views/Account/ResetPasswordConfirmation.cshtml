@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-custom p-4 p-md-5 border-0 shadow text-center">
                <div class="brand-icon mx-auto mb-3 bg-success-subtle text-success" style="width: 50px; height: 50px; font-size: 1.5rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Thành công!</h3>
                <p class="text-secondary small mb-4">
                    Mật khẩu của bạn đã được cập nhật thành công. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.
                </p>
                <a asp-action="Login" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                </a>
            </div>
        </div>
    </div>
</div>
