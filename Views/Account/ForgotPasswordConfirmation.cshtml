@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-custom p-4 p-md-5 border-0 shadow text-center">
                <div class="brand-icon mx-auto mb-3 bg-success-subtle text-success" style="width: 50px; height: 50px; font-size: 1.5rem;">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Đã gửi hướng dẫn!</h3>
                <p class="text-secondary small mb-4">
                    Nếu địa chỉ email bạn nhập tồn tại trên hệ thống, chúng tôi đã gửi đường dẫn đặt lại mật khẩu. Vui lòng kiểm tra hộp thư đến (hoặc thư mục Spam/Quảng cáo).
                </p>
                <div class="p-3 bg-light rounded-3 text-muted small text-start mb-4">
                    <i class="bi bi-info-circle text-primary me-1"></i>
                    <strong>Lưu ý:</strong> Liên kết đặt lại mật khẩu có hiệu lực trong vòng 24 giờ. Trong môi trường phát triển (Dev), đường dẫn cũng được ghi lại trong Console/Log hệ thống.
                </div>
                <a asp-action="Login" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Quay lại Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>
