@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card card-custom p-5 border-0 shadow">
                <div class="brand-icon mx-auto mb-3 bg-danger-subtle text-danger" style="width: 60px; height: 60px; font-size: 2rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">403 - Quyền truy cập bị từ chối</h2>
                <p class="text-secondary mb-4">
                    Bạn không có quyền truy cập vào khu vực này. Nếu bạn cho rằng đây là một sự nhầm lẫn, vui lòng liên hệ Quản trị viên để được cấp quyền.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom">
                        <i class="bi bi-house me-1"></i> Trang chủ
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-custom">
                        <i class="bi bi-speedometer2 me-1"></i> Đến Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
