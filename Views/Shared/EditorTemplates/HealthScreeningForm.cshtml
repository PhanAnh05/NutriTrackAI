@using NutriTrackAI.Services
@model HealthScreeningForm
@{
    var conditionName = ViewData.TemplateInfo.GetFullHtmlFieldName(nameof(Model.Conditions));
    var doctorVisible = GoalPolicy.HealthConditionOptions.Any(option =>
        option.Tier == HealthTier.NeedsDoctor && Model.Conditions?.Contains(option.Condition) == true);
}
<fieldset id="health-screening" class="border rounded-3 p-3 mb-3" data-health-screening>
    <legend class="float-none w-auto px-2 fs-6 fw-semibold">Tình trạng sức khỏe</legend>
    <p class="small text-muted">@GoalPolicy.HealthScreeningDisclaimer</p>
    <div class="form-check mb-3">
        <input asp-for="NoConditions" class="form-check-input" data-health-none />
        <label asp-for="NoConditions" class="form-check-label">Tôi không có bệnh nền nào trong danh sách</label>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-2 mb-3">
        @foreach (var option in GoalPolicy.HealthConditionOptions)
        {
            var id = $"health-condition-{option.Condition}";
            <div class="col">
                <div class="form-check">
                    <input type="checkbox" name="@conditionName" value="@option.Condition" id="@id" class="form-check-input"
                           checked="@(Model.Conditions?.Contains(option.Condition) == true)"
                           data-health-condition data-doctor-option="@(option.Tier == HealthTier.NeedsDoctor ? "true" : "false")" />
                    <label for="@id" class="form-check-label">@option.Label</label>
                </div>
            </div>
        }
    </div>
    <div class="form-check mb-2" data-health-doctor hidden="@(!doctorVisible)">
        <input asp-for="DoctorAwareOfPlan" class="form-check-input" />
        <label asp-for="DoctorAwareOfPlan" class="form-check-label">Bác sĩ đã biết kế hoạch giảm/tăng cân của tôi</label>
    </div>
    <div class="small text-danger" role="status" data-health-error></div>
    @Html.ValidationMessage("", new { @class = "small text-danger" })
    <span asp-validation-for="Conditions" class="small text-danger"></span>
</fieldset>
