@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@model Food
@{
    var imageUrl = FoodImageUrl.Resolve(Model.Name, Model.ImageUrl, HostEnvironment.WebRootFileProvider);
}
@if (!string.IsNullOrWhiteSpace(imageUrl))
{
    <img src="@imageUrl" alt="@Model.Name" loading="lazy" decoding="async"
         class="w-100 rounded-3 mb-3" style="aspect-ratio: 1 / 1; object-fit: cover;" />
}
