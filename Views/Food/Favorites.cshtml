@model List<Food>
@{
    ViewData["Title"] = "Món ăn yêu thích của bạn";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-danger-subtle text-danger mb-2">Thực đơn quen thuộc</span>
            <h2 class="fw-bold text-dark mb-1">Món Ăn Yêu Thích Của Bạn</h2>
            <p class="text-muted small mb-0">Danh sách các món bạn thường dùng để thêm nhanh vào nhật ký bữa ăn hằng ngày.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-search me-1"></i> Tra cứu danh mục chung
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var food in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card card-custom h-100 border p-3 d-flex flex-column justify-content-between position-relative shadow-sm">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-light text-secondary border">@food.Category.Name</span>
                                <form asp-action="ToggleFavorite" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="foodId" value="@food.Id" />
                                    <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-none p-1 text-danger" title="Bỏ yêu thích">
                                        <i class="bi bi-heart-fill fs-5"></i>
                                    </button>
                                </form>
                            </div>

                            <h5 class="fw-bold text-dark mb-1">
                                <a asp-action="Details" asp-route-id="@food.Id" class="text-decoration-none text-dark hover-emerald">
                                    @food.Name
                                </a>
                            </h5>
                            <small class="text-muted d-block mb-3">
                                <i class="bi bi-box me-1"></i>Khẩu phần: <strong>@food.ServingName</strong> (@food.ServingSize.ToString("0.#")g)
                            </small>

                            <div class="p-2 bg-light rounded-3 mb-3 border">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <span class="small text-muted">Năng lượng:</span>
                                    <strong class="text-success fs-5">@food.Calories.ToString("0.#") kcal</strong>
                                </div>
                                <div class="d-flex justify-content-between text-muted small border-top pt-1" style="font-size: 0.78rem;">
                                    <span>P: <strong>@food.Protein.ToString("0.#")g</strong></span>
                                    <span>C: <strong>@food.Carb.ToString("0.#")g</strong></span>
                                    <span>F: <strong>@food.Fat.ToString("0.#")g</strong></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@food.Id" class="btn btn-sm btn-outline-custom w-100">
                                Xem chi tiết
                            </a>
                            <a asp-controller="MealLog" asp-action="Index" class="btn btn-sm btn-primary-custom text-nowrap" title="Thêm vào nhật ký">
                                <i class="bi bi-plus-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card card-custom p-5 text-center border-0 shadow-sm">
            <i class="bi bi-heart text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-dark mb-2">Bạn chưa đánh dấu món ăn yêu thích nào</h4>
            <p class="text-muted small mb-4">Trong danh mục món ăn hoặc trang chi tiết, bấm vào biểu tượng trái tim để lưu lại những món bạn yêu thích.</p>
            <div>
                <a asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-search me-1"></i> Khám phá danh mục món ăn
                </a>
            </div>
        </div>
    }
</div>
