@model FoodIndexViewModel
@{
    ViewData["Title"] = "Danh mục Thực phẩm & Tra cứu Dinh dưỡng";
}

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge badge-custom-emerald mb-2">Thư viện dinh dưỡng</span>
            <h2 class="fw-bold text-dark mb-1">Tra Cứu Danh Mục Món Ăn</h2>
            <p class="text-muted small mb-0">Hơn @Model.TotalItems món ăn Việt Nam được chuẩn hóa định lượng và thành phần dinh dưỡng.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex gap-2 flex-wrap">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Foods" asp-action="Create" class="btn btn-outline-success">
                        <i class="bi bi-plus-circle me-1"></i> Thêm món mới (Admin)
                    </a>
                }
                <a asp-action="Favorites" class="btn btn-outline-danger">
                    <i class="bi bi-heart-fill me-1"></i> Món yêu thích
                </a>
                <a asp-controller="MealLog" asp-action="Index" class="btn btn-primary-custom">
                    <i class="bi bi-journal-check me-1"></i> Đến Nhật ký bữa ăn
                </a>
            </div>
        }
    </div>

    <!-- Filter Bar Card -->
    <div class="card card-custom p-4 mb-4 border-0 shadow-sm">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <!-- Search Text -->
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Tìm kiếm theo tên hoặc nguyên liệu:</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Ví dụ: phở, ức gà, tôm, đậu hũ..." value="@Model.Search" />
                </div>
            </div>

            <!-- Category -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Nhóm thực phẩm:</label>
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả các nhóm --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>

            <!-- Calorie Range -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Khoảng Calo (kcal):</label>
                <div class="input-group">
                    <input type="number" name="minCal" class="form-control" placeholder="Từ" value="@Model.MinCal" />
                    <span class="input-group-text bg-light">-</span>
                    <input type="number" name="maxCal" class="form-control" placeholder="Đến" value="@Model.MaxCal" />
                </div>
            </div>

            <!-- Filter Buttons & Vegetarian Checkbox -->
            <div class="col-md-2 d-flex flex-column gap-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="isVegetarian" value="true" id="checkVeg" @(Model.IsVegetarian == true ? "checked" : "") />
                    <label class="form-check-label small fw-semibold text-secondary" for="checkVeg">
                        Món chay <i class="bi bi-flower1 text-success"></i>
                    </label>
                </div>
                <div class="d-flex gap-1">
                    <button type="submit" class="btn btn-primary-custom w-100 py-1">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-1" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Foods Grid -->
    @if (Model.Foods.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var food in Model.Foods)
            {
                var isFav = Model.FavoriteFoodIds.Contains(food.Id);
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card card-custom h-100 border p-3 d-flex flex-column justify-content-between position-relative shadow-sm">
                        <!-- Top Badges & Favorite Button -->
                        <div>
                            <partial name="_FoodImage" model="food" />
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-light text-secondary border">
                                    @food.Category.Name
                                </span>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="btn btn-sm btn-light rounded-circle shadow-none p-1 favorite-btn @(isFav ? "text-danger" : "text-muted")" data-food-id="@food.Id" onclick="toggleFav(this, @food.Id)" title="Yêu thích">
                                        <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart") fs-5"></i>
                                    </button>
                                }
                            </div>

                            <!-- Food Name & Serving -->
                            <h5 class="fw-bold text-dark mb-1">
                                <a asp-action="Details" asp-route-id="@food.Id" class="text-decoration-none text-dark hover-emerald">
                                    @food.Name
                                </a>
                            </h5>
                            <small class="text-muted d-block mb-3">
                                <i class="bi bi-box me-1"></i>Khẩu phần: <strong>@food.ServingName</strong> (@food.ServingSize.ToString("0.#")g)
                            </small>

                            <!-- Calorie & Macros Box -->
                            <div class="p-2 bg-light rounded-3 mb-3 border">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <span class="small text-muted">Năng lượng:</span>
                                    <strong class="text-success fs-5">@food.Calories.ToString("0.#") <small class="fs-6">kcal</small></strong>
                                </div>
                                <div class="d-flex justify-content-between text-muted small border-top pt-1" style="font-size: 0.78rem;">
                                    <span>P: <strong class="text-dark">@food.Protein.ToString("0.#")g</strong></span>
                                    <span>C: <strong class="text-dark">@food.Carb.ToString("0.#")g</strong></span>
                                    <span>F: <strong class="text-dark">@food.Fat.ToString("0.#")g</strong></span>
                                </div>
                            </div>

                            <!-- Allergen Notes if any -->
                            @if (food.HasAllergenNotes)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small text-wrap text-start">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Dị ứng: @food.AllergenNotes
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Card Footer Action -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@food.Id" class="btn btn-sm btn-outline-custom w-100">
                                Chi tiết
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="MealLog" asp-action="Index" class="btn btn-sm btn-primary-custom text-nowrap" title="Ghi nhật ký">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-minCal="@Model.MinCal" asp-route-maxCal="@Model.MaxCal" asp-route-isVegetarian="@Model.IsVegetarian">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-minCal="@Model.MinCal" asp-route-maxCal="@Model.MaxCal" asp-route-isVegetarian="@Model.IsVegetarian">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-minCal="@Model.MinCal" asp-route-maxCal="@Model.MaxCal" asp-route-isVegetarian="@Model.IsVegetarian">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card card-custom p-5 text-center border-0 shadow-sm">
            <i class="bi bi-search text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-dark mb-2">Không tìm thấy món ăn phù hợp</h4>
            <p class="text-muted small mb-4">Hãy thử tìm với từ khóa khác hoặc điều chỉnh lại các tiêu chí lọc.</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-custom">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa tất cả bộ lọc
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleFav(btn, foodId) {
            try {
                const response = await fetch('@Url.Action("ToggleFavorite", "Food")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: 'foodId=' + foodId
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        const icon = btn.querySelector('i');
                        if (data.isFavorite) {
                            btn.classList.remove('text-muted');
                            btn.classList.add('text-danger');
                            icon.classList.remove('bi-heart');
                            icon.classList.add('bi-heart-fill');
                        } else {
                            btn.classList.remove('text-danger');
                            btn.classList.add('text-muted');
                            icon.classList.remove('bi-heart-fill');
                            icon.classList.add('bi-heart');
                        }
                    }
                }
            } catch (err) {
                console.error("Lỗi toggle yêu thích:", err);
            }
        }
    </script>
}
