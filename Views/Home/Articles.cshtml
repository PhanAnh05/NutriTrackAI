@model List<Article>
@{
    ViewData["Title"] = "Kiến thức Dinh dưỡng & FAQ";
}

<div class="container py-5">
    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge badge-custom-emerald mb-2">Thư viện thông tin</span>
        <h1 class="fw-bold text-dark">Kiến Thức Dinh Dưỡng & Hỏi Đáp Thường Gặp</h1>
        <p class="text-muted">Tổng hợp kiến thức nền tảng về calo, chất đạm, giảm cân an toàn và các giải đáp y khoa tham khảo.</p>
    </div>

    <!-- Category Filter Tabs -->
    <ul class="nav nav-pills justify-content-center mb-4 gap-2" id="articlesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="all-tab" data-bs-toggle="pill" data-bs-target="#all-content" type="button" role="tab">Tất cả</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="faq-tab" data-bs-toggle="pill" data-bs-target="#faq-content" type="button" role="tab">Câu hỏi thường gặp (FAQ)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="article-tab" data-bs-toggle="pill" data-bs-target="#article-content" type="button" role="tab">Bài viết dinh dưỡng</button>
        </li>
    </ul>

    <div class="tab-content" id="articlesTabContent">
        <!-- All Content -->
        <div class="tab-pane fade show active" id="all-content" role="tabpanel">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6">
                        <div class="card card-custom h-100 p-4 border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge @(item.Type == ArticleType.Disclaimer ? "bg-warning-subtle text-warning-emphasis" : item.Type == ArticleType.Faq ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">
                                    @(item.Type == ArticleType.Disclaimer ? "Cảnh báo Y tế" : item.Type == ArticleType.Faq ? "FAQ" : "Bài viết")
                                </span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>Cập nhật: @item.UpdatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="fw-bold text-dark mb-3">@item.Title</h5>
                            <div class="text-secondary small" style="white-space: pre-line;">
                                @item.Body
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- FAQ Content -->
        <div class="tab-pane fade" id="faq-content" role="tabpanel">
            <div class="row g-4">
                @foreach (var item in Model.Where(a => a.Type == ArticleType.Faq))
                {
                    <div class="col-md-6">
                        <div class="card card-custom h-100 p-4 border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary-subtle text-primary">FAQ</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.UpdatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="fw-bold text-dark mb-3">@item.Title</h5>
                            <div class="text-secondary small" style="white-space: pre-line;">
                                @item.Body
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Article Content -->
        <div class="tab-pane fade" id="article-content" role="tabpanel">
            <div class="row g-4">
                @foreach (var item in Model.Where(a => a.Type == ArticleType.Article))
                {
                    <div class="col-md-6">
                        <div class="card card-custom h-100 p-4 border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-success-subtle text-success">Bài viết</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.UpdatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="fw-bold text-dark mb-3">@item.Title</h5>
                            <div class="text-secondary small" style="white-space: pre-line;">
                                @item.Body
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
