@using System.Globalization
@model NutriTrackAI.Models.ViewModels.DashboardViewModel
@using NutriTrackAI.Models.Enums
@{
    ViewData["Title"] = "Dashboard Tổng quan";
    ViewData["BodyClass"] = "dashboard-shell";
    var now = GoalPolicy.Now;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var todayStr = now.ToString("dddd, dd/MM/yyyy", vi);

    var hour = now.Hour;
    var greeting = hour < 12 ? "Chào buổi sáng" : (hour < 18 ? "Chào buổi chiều" : "Chào buổi tối");

    var calPercent = Model.DailyCalorieTarget > 0
        ? Math.Round(Model.CaloriesConsumedToday * 100 / Model.DailyCalorieTarget)
        : 0;

    var remainingPercent = Model.DailyCalorieTarget > 0
        ? Math.Clamp(Model.RemainingCalories * 100 / Model.DailyCalorieTarget, 0, 100)
        : 0;
    var totalMacroCal = (Model.ActualProtein * 4) + (Model.ActualCarb * 4) + (Model.ActualFat * 9);
    var hasMacroData = totalMacroCal > 0;
    var pActualPercent = hasMacroData ? (int)Math.Round((Model.ActualProtein * 4 * 100) / totalMacroCal) : Model.RecommendedProteinPercent;
    var cActualPercent = hasMacroData ? (int)Math.Round((Model.ActualCarb * 4 * 100) / totalMacroCal) : Model.RecommendedCarbPercent;
    var fActualPercent = hasMacroData ? (int)Math.Round((Model.ActualFat * 9 * 100) / totalMacroCal) : Model.RecommendedFatPercent;

    var calorieHeroStateClass = Model.RemainingCalories > 50
        ? "is-safe"
        : (Model.RemainingCalories >= -50 ? "is-warning" : "is-danger");


    var waterRemainingMl = Math.Max(0, Model.DailyWaterGoalMl - Model.TotalWaterTodayMl);
    var budget = Model.Budget;
    var hasMacroTargets = !budget.Suspended && Model.MacroUnavailableReason == null;
    var dietLabel = Model.DietType.GetVietnameseLabel();
    var consumedDisplay = Model.CaloriesConsumedToday.ToString("N0", vi);
    var meals = new[] {
        ("Bữa sáng", "sunrise", Model.BreakfastCalories),
        ("Bữa trưa", "sun", Model.LunchCalories),
        ("Bữa tối", "moon-stars", Model.DinnerCalories),
        ("Bữa phụ", "apple", Model.SnackCalories)
    };
    var weightGoalLabel = !Model.HasActiveGoal ? "Chỉ theo dõi" : budget.Suspended
        ? $"{Model.GoalTypeName} (kế hoạch calo tạm ngừng)" : Model.GoalTypeName;
}

@section Styles {
    <link rel="stylesheet" href="~/fonts/be-vietnam-pro/font.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutri-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-water.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-weight.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-nutrition.css" asp-append-version="true" />
}

<div class="container dashboard-page">
    <form id="antiForgeryForm" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <header class="dash-overview">
        <div class="dash-overview-copy">
            <time class="dash-date" datetime="@now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"><i class="bi bi-calendar-event" aria-hidden="true"></i> @todayStr</time>
            <h1>Tổng quan hôm nay</h1>
            <div class="dash-intro">
                <span>@greeting, <strong>@Model.FullName</strong></span>
                <span class="dash-context"><i class="bi bi-bullseye" aria-hidden="true"></i> @(budget.UsesMaintenanceReference ? "Chỉ theo dõi" : Model.GoalTypeName)</span>
                <span class="dash-context"><i class="bi bi-flower1" aria-hidden="true"></i> @dietLabel</span>
            </div>
        </div>
        <div class="dash-hero-art" aria-hidden="true">
            <img src="~/images/dashboard/handoff/hero-woman-drinking.png" alt="" width="475" height="481" />
        </div>
        <div class="dash-overview-profile">
            <dl class="dash-baseline">
                <div title="@GoalPolicy.AdultBmiReference">
                    <dt><i class="bi bi-person-badge" aria-hidden="true"></i> BMI</dt><dd>@Model.Bmi.ToString("0.0", vi) <small>@Model.BmiCategory</small></dd>
                </div>
                <div><dt><i class="bi bi-fire" aria-hidden="true"></i> BMR</dt><dd>@Model.Bmr.ToString("N0", vi) <small>kcal</small></dd></div>
                <div><dt><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> TDEE</dt><dd>@Model.Tdee.ToString("N0", vi) <small>kcal</small></dd></div>
            </dl>
            <a asp-controller="Profile" asp-action="Index" class="dash-profile-link">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="" width="22" height="22" />
                }
                else
                {
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                }
                Hồ sơ
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger mb-4" role="alert">@errorMessage</div>
    }
    @if (Model.WeightMismatch is not null)
    {
        <partial name="_WeightMismatchBanner" model="Model.WeightMismatch" />
    }

    @if (budget.Suspended)
    {
        <div class="dash-plan-alert mb-4" role="status">
            <i class="bi bi-pause-fill" aria-hidden="true"></i>
            <div>
                <p class="mb-2">@(budget.Health.PublicSuspensionReason != null
                    ? $"Kế hoạch calo đang tạm ngừng. {budget.Health.PublicSuspensionReason}"
                    : budget.Explanation)</p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Profile" asp-action="Index" asp-fragment="health-screening" class="alert-link">Cập nhật hồ sơ sức khỏe</a>
                    <a asp-controller="Goal" asp-action="Index" class="alert-link">Xem đánh giá kế hoạch</a>
                </div>
            </div>
        </div>
    }
    else if (budget.Health.NeedsScreening)
    {
        <p class="dash-screening-note"><i class="bi bi-info-circle" aria-hidden="true"></i> @GoalPolicy.HealthScreeningPrompt
            <a asp-controller="Profile" asp-action="Index" asp-fragment="health-screening">Cập nhật sàng lọc</a>
        </p>
    }

    <section class="dash-surface mb-4" data-dashboard-section="calories" aria-labelledby="heading-calories">
        <div class="energy-heading">
            <h2 id="heading-calories"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Cân bằng năng lượng</h2>
            <a asp-controller="MealLog" asp-action="Index" class="dash-btn-emerald">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Ghi nhật ký bữa ăn
            </a>
        </div>
        <div class="energy-body">
            <div class="energy-balance @calorieHeroStateClass">
                <div class="energy-meter">
                    <svg viewBox="0 0 240 172" aria-hidden="true" focusable="false">
                        <defs>
                            <path id="balance-arc" d="M 16,154 A 111,111 0 1,1 224,154" pathLength="100" />
                        </defs>
                        <use class="energy-track" href="#balance-arc" />
                        @if (remainingPercent > 0)
                        {
                            <g stroke-dasharray="@(remainingPercent.ToString("0.##", CultureInfo.InvariantCulture)) 100">
                                <use class="energy-rim" href="#balance-arc" />
                                <use class="energy-remaining" href="#balance-arc" />
                            </g>
                        }
                    </svg>
                    <div class="energy-reading">
                        <span>@(budget.UsesMaintenanceReference ? "Còn lại so với mốc duy trì (TDEE)" : "Calo còn lại hôm nay")</span>
                        <strong>@Model.RemainingCalories.ToString("N0", vi)</strong>
                        <small>kcal</small>
                    </div>
                </div>
                <div class="energy-status"><i class="bi @(budget.UsesMaintenanceReference ? "bi-eye" : "bi-bullseye")" aria-hidden="true"></i>
                    @(budget.UsesMaintenanceReference ? "Chỉ theo dõi" : Model.CalorieStatusText)
                </div>
            </div>
            <div class="energy-ledger">
                <dl class="energy-values">
                    <div>
                        <dt>@budget.ReferenceLabel</dt>
                        <dd>@Model.DailyCalorieTarget.ToString("N0", vi) <small>kcal</small></dd>
                    </div>
                    <div>
                        <dt>Đã nạp</dt>
                        <dd>@consumedDisplay <small>kcal</small></dd>
                        <small>@(Model.TotalMealItemsLogged > 0 ? $"Đã ghi {Model.TotalMealItemsLogged} món" : "Chưa ghi món")</small>
                    </div>
                    <div>
                        <dt>Vận động</dt>
                        <dd>@Model.CaloriesBurnedToday.ToString("N0", vi) <small>kcal</small></dd>
                        <small>@(Model.CaloriesBurnedToday > 0 ? $"Cộng lại {Model.ExerciseCreditApplied.ToString("N0", vi)} kcal" : "Chưa ghi tập")</small>
                    </div>
                </dl>
                <div class="energy-intake">
                    <label for="intake-progress">@(budget.UsesMaintenanceReference ? "Đã nạp so với mốc duy trì" : "Đã nạp so với ngân sách")</label>
                    <strong>@calPercent.ToString("N0", vi)%</strong>
                    <progress id="intake-progress" value="@Math.Clamp(calPercent, 0, 100)" max="100">@calPercent%</progress>
                </div>
                <dl class="meal-totals">
                    @foreach (var (label, icon, calories) in meals)
                    {
                        <div>
                            <dt><i class="bi bi-@icon" aria-hidden="true"></i> @label</dt>
                            <dd>@calories.ToString("N0", vi) <small>kcal</small></dd>
                        </div>
                    }
                </dl>
                @if (Model.TotalMealItemsLogged == 0)
                {
                    <p class="energy-empty">Hôm nay chưa có bữa ăn nào được ghi nhận.
                        <a asp-controller="MealLog" asp-action="Index">Thêm món ăn đầu tiên</a>
                    </p>
                }
            </div>
        </div>
        <details class="energy-method">
            <summary>Cách tính calo còn lại</summary>
            <p><strong>@budget.ReferenceLabel (@Model.DailyCalorieTarget.ToString("N0", vi)) − Đã nạp (@consumedDisplay) + Phần vận động được cộng (@Model.ExerciseCreditApplied.ToString("N0", vi)) = @Model.RemainingCalories.ToString("N0", vi) kcal</strong></p>
            <p>TDEE đã gồm vận động thường ngày. Hệ thống cộng @GoalPolicy.ExerciseCreditRate.ToString("P0", vi) calo vận động đã ghi, tối đa @GoalPolicy.MaxExerciseCredit.ToString("N0", vi) kcal/ngày.</p>
            @if (!budget.Suspended)
            {
                <p>@budget.Explanation <a asp-controller="Goal" asp-action="Index">Xem đánh giá kế hoạch</a></p>
            }
        </details>
    </section>
    @if (budget.Goal?.GoalType == GoalType.Lose && !budget.Suspended)
    {
        <partial name="_BodyCheckIn" model="budget" />
    }

    <!-- Hàng 2: Trên điện thoại xếp Nước trước Cân nặng (Calo -> Nước -> Cân nặng -> Dinh dưỡng) -->
    <div class="row g-3 mb-4 dashboard-tracking-row">
        <div class="col-12 col-lg-4">
            <section class="dash-surface hydration-card h-100" data-dashboard-section="water" aria-labelledby="heading-water">
                <h2 id="heading-water" class="h5 fw-bold mb-0">
                    <i class="bi bi-droplet me-2" aria-hidden="true"></i>Nước uống hôm nay
                </h2>
                <div class="hydration-reading">
                    <div>
                        <a asp-controller="WaterExercise" asp-action="Index" class="hydration-link">
                            Nhật ký nước <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                        </a>
                        <div class="hydration-label">Đã uống</div>
                        <div id="dashTotalWater" class="hydration-volume">
                            <strong id="dashWaterAmount">@Model.TotalWaterTodayMl.ToString("N0", vi)</strong>
                            <span>ml</span>
                        </div>
                    </div>
                    <img class="hydration-illustration" src="~/images/dashboard/handoff/water-glass.png" width="384" height="448" alt="" aria-hidden="true" />
                </div>

                <div class="hydration-meter">
                    <div class="hydration-goal">
                        <span>Mục tiêu <strong id="dashWaterGoal">@Model.DailyWaterGoalMl.ToString("N0", vi) ml</strong></span>
                        <strong id="dashWaterBadge">@Model.WaterProgressPercent%</strong>
                    </div>
                    <div class="dash-progress" role="progressbar" aria-label="Tiến độ uống nước trong ngày" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.WaterProgressPercent">
                        <div class="dash-progress-bar-emerald" id="dashWaterBar" style="width: @Model.WaterProgressPercent%"></div>
                    </div>
                </div>

                <div class="hydration-actions" role="group" aria-label="Ghi nhanh nước uống" aria-busy="false" id="dashWaterActions">
                    <button type="button" class="dash-btn-emerald" id="btnQuickWater250" onclick="quickAddWater(250)" aria-label="Ghi nhanh 250 ml nước">
                        +250 ml
                    </button>
                    <button type="button" class="dash-btn-outline" onclick="quickAddWater(500)" aria-label="Ghi nhanh 500 ml nước">
                        +500 ml
                    </button>
                </div>

                <p class="hydration-status" id="dashWaterStateBox" role="status" aria-live="polite" aria-atomic="true">
                    <span id="dashWaterStateText">
                        @if (Model.TotalWaterTodayMl == 0)
                        {
                            <text>Chưa ghi nước hôm nay.</text>
                        }
                        else if (waterRemainingMl > 0)
                        {
                            <text>Còn @waterRemainingMl.ToString("N0", vi) ml để đạt mục tiêu hôm nay.</text>
                        }
                        else
                        {
                            <text>Đã đạt mục tiêu nước uống hôm nay.</text>
                        }
                    </span>
                </p>

                <a asp-controller="WaterExercise" asp-action="Index" asp-fragment="selectExercise" class="hydration-link hydration-exercise">
                    <i class="bi bi-activity" aria-hidden="true"></i> Nhật ký vận động <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>
            </section>
        </div>

        <div class="col-12 col-lg-8">
            <section class="dash-surface weight-panel h-100" data-dashboard-section="weight" aria-labelledby="heading-weight">
                <header class="weight-panel-heading">
                    <h2 id="heading-weight" class="h5 fw-bold mb-0"><i class="bi bi-bar-chart me-2" aria-hidden="true"></i>Cân nặng và xu hướng</h2>
                    <a asp-controller="WeightLog" asp-action="Index" asp-fragment="weightFormHeading" class="dash-btn-outline">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Ghi cân nặng
                    </a>
                </header>

                <div class="weight-summary @(Model.HasActiveGoal ? null : "weight-summary-tracking")">
                    <dl class="weight-readings">
                        <div class="weight-current">
                            <dt>Hiện tại</dt>
                            <dd>@Model.CurrentWeightKg.ToString("0.0", vi) <span>kg</span></dd>
                        </div>
                        @if (Model.HasActiveGoal)
                        {
                            <div>
                                <dt>@(budget.Suspended ? "Mục tiêu đã lưu" : "Mục tiêu")</dt>
                                <dd>@Model.TargetWeightKg.ToString("0.0", vi) <span>kg</span></dd>
                            </div>
                            <div>
                                <dt>Khởi điểm</dt>
                                <dd>@Model.StartingWeightKg.ToString("0.0", vi) <span>kg</span></dd>
                            </div>
                        }
                    </dl>

                    <div class="weight-plan">
                        <div class="weight-plan-line">
                            <span><i class="bi @(budget.UsesMaintenanceReference ? "bi-eye" : "bi-bullseye")" aria-hidden="true"></i> @weightGoalLabel</span>
                            <a asp-controller="Goal" asp-action="Index">Kế hoạch mục tiêu <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </div>
                        @if (Model.HasActiveGoal && !budget.Suspended)
                        {
                            <div class="weight-progress-detail">
                                <span>Tiến độ <strong>@Model.GoalProgressPercent.ToString("0.#", vi)%</strong></span>
                                <span>
                                    Cách đích @Model.WeightDifferenceRemaining.ToString("0.0", vi) kg
                                    @if (Model.DaysRemaining > 0)
                                    {
                                        <text> · Còn @Model.DaysRemaining ngày</text>
                                    }
                                </span>
                            </div>
                            <div class="dash-progress" role="progressbar" aria-label="Tiến độ mục tiêu cân nặng"
                                 aria-valuenow="@Model.GoalProgressPercent.ToString(CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                                <div class="dash-progress-bar-emerald" style="width: @(Model.GoalProgressPercent.ToString(CultureInfo.InvariantCulture))%"></div>
                            </div>
                        }
                    </div>
                </div>

                <div class="weight-trend">
                    <h3 class="weight-trend-title">Xu hướng 30 ngày</h3>
                    @if (Model.WeightChartValues.Count > 1)
                    {
                        var trendChange = Model.WeightChartValues[^1] - Model.WeightChartValues[0];
                        var trendSummary = trendChange == 0 ? "không đổi"
                            : $"{(trendChange > 0 ? "tăng" : "giảm")} {Math.Abs(trendChange).ToString("0.0", vi)} kg";
                        <p id="weightTrendSummary" class="weight-trend-summary">Ngày @Model.WeightChartLabels[^1], cân nặng @trendSummary so với ngày @Model.WeightChartLabels[0].</p>
                        <div class="weight-chart-frame">
                            <canvas id="weightTrendChart" role="img" aria-label="Biểu đồ cân nặng theo các ngày ghi nhận" aria-describedby="weightTrendSummary"></canvas>
                        </div>
                        <details class="weight-data">
                            <summary>Xem bảng số liệu</summary>
                            <div class="weight-table-scroll" tabindex="0" role="region" aria-label="Các mốc cân trên biểu đồ">
                                <table>
                                    <caption class="visually-hidden">Số liệu trên biểu đồ xu hướng cân nặng</caption>
                                    <thead><tr><th scope="col">Ngày</th><th scope="col">Cân nặng (kg)</th></tr></thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.WeightChartLabels.Count; i++)
                                        {
                                            <tr><th scope="row">@Model.WeightChartLabels[i]</th><td>@Model.WeightChartValues[i].ToString("0.0", vi)</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                    else
                    {
                        <div class="weight-empty">
                            <img src="~/images/dashboard/handoff/weight-scale.png" width="443" height="411" alt="" aria-hidden="true" loading="lazy" />
                            <p>Chưa đủ mốc cân để hiển thị xu hướng trong 30 ngày.</p>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <!-- 4. KHỐI DINH DƯỠNG: Dinh dưỡng đa lượng (Macros) & Gợi ý món ăn theo calo còn lại -->
    <section class="mb-4" data-dashboard-section="nutrition" aria-labelledby="heading-nutrition">
        <div class="dash-surface nutrition-panel mb-4">
            <div class="nutrition-heading">
                <div class="nutrition-title">
                    <i class="bi bi-egg-fried" aria-hidden="true"></i>
                    <div>
                        <h2 id="heading-nutrition" class="h5 fw-bold mb-1">Dinh dưỡng hôm nay</h2>
                        <p class="text-muted small mb-0 dash-measure">
                            @(hasMacroTargets ? $"So sánh lượng đã nạp với mức tham khảo theo chế độ ăn {dietLabel}." : $"Lượng đã nạp theo nhật ký · Chế độ ăn {dietLabel}.")
                        </p>
                    </div>
                </div>
                <a asp-controller="MealPlan" asp-action="Index" class="dash-btn-outline py-1 px-3">
                    <i class="bi bi-calendar2-check text-emerald" aria-hidden="true"></i>
                    <span>Thực đơn gợi ý</span>
                </a>
            </div>

            <div class="nutrition-content @(hasMacroData || hasMacroTargets ? "nutrition-with-chart" : "")">
                <!-- Biểu đồ tròn Macros -->
                <div class="nutrition-chart text-center" hidden="@(!hasMacroData && !hasMacroTargets)">
                    <div style="max-width: 210px; margin: 0 auto; position: relative;">
                        <canvas id="macroDoughnutChart" width="210" height="210" aria-hidden="true"></canvas>
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">@(hasMacroData ? "Đã nạp" : budget.UsesMaintenanceReference ? "Mốc duy trì" : "Ngân sách")</span>
                            <strong class="fs-5 text-dark dash-tabular">
                                @(hasMacroData ? $"{consumedDisplay} kcal" : $"{Model.DailyCalorieTarget.ToString("N0", vi)} kcal")
                            </strong>
                        </div>
                    </div>
                    <div class="small text-muted mt-2 dash-tabular">
                        @if (hasMacroData)
                        {
                            <span>Thực tế: <strong>@pActualPercent% Chất đạm · @cActualPercent% Tinh bột · @fActualPercent% Chất béo</strong></span>
                        }
                        else
                        {
                            <span>Tham khảo: <strong>@Model.RecommendedProteinPercent% Chất đạm · @Model.RecommendedCarbPercent% Tinh bột · @Model.RecommendedFatPercent% Chất béo</strong></span>
                        }
                    </div>
                </div>

                <!-- Thanh đối chiếu chất đạm, tinh bột và chất béo -->
                <div class="dash-macro-list">
                    @if (!hasMacroData)
                    {
                        <p class="nutrition-empty-note">
                            <i class="bi bi-journal-medical" aria-hidden="true"></i>
                            <span><strong>Chưa có dữ liệu dinh dưỡng hôm nay.</strong>
                            @if (hasMacroTargets) { <span>Biểu đồ đang hiển thị tỷ lệ phân bổ tham khảo.</span> }</span>
                        </p>
                    }
                    @if (Model.MacroUnavailableReason is { } macroReason)
                    {
                        <p class="nutrition-notice" role="status">@macroReason</p>
                    }
                    <div>
                        @foreach (var (key, icon, label, grams, target, share) in new[] {
                            ("protein", "lightning-charge-fill", "Chất đạm", Model.ActualProtein, Model.RecommendedProteinGrams, Model.RecommendedProteinPercent),
                            ("carb", "flower3", "Tinh bột", Model.ActualCarb, Model.RecommendedCarbGrams, Model.RecommendedCarbPercent),
                            ("fat", "droplet-fill", "Chất béo", Model.ActualFat, Model.RecommendedFatGrams, Model.RecommendedFatPercent)
                        })
                        {
                            <div class="dash-macro-row nutrient-@key">
                                <strong class="nutrient-name"><i class="bi bi-@icon" aria-hidden="true"></i>@label</strong>
                                @if (hasMacroTargets && target > 0)
                                {
                                    var progress = (int)Math.Clamp(Math.Round(grams * 100 / target), 0, 100);
                                    <div class="dash-progress" role="progressbar" aria-label="@label so với mức tham khảo"
                                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                        <div class="nutrient-bar" style="width: @(progress)%"></div>
                                    </div>
                                }
                                else if (grams == 0)
                                {
                                    <span class="nutrient-empty-track" aria-hidden="true"></span>
                                }
                                <span class="nutrient-amount">Đã nạp <b>@grams.ToString("0.0", vi) g</b>
                                    @if (hasMacroTargets)
                                    {
                                        <small>Tham khảo ~@target.ToString("0.0", vi) g (@share%)</small>
                                    }
                                </span>
                            </div>
                        }
                    </div>

                    <div class="nutrition-minerals small text-muted dash-tabular">
                        <span><i class="bi bi-flower1" aria-hidden="true"></i> Chất xơ: <strong class="text-dark">@Model.ActualFiber.ToString("0.0", vi) g</strong></span>
                        <span><i class="bi bi-box" aria-hidden="true"></i> Đường: <strong class="text-dark">@Model.ActualSugar.ToString("0.0", vi) g</strong></span>
                        @if (!budget.Health.Constraints.MaxSodiumMg.HasValue)
                        {
                            <span><i class="bi bi-moisture" aria-hidden="true"></i> Natri: <strong class="text-dark">@Model.ActualSodium.ToString("N0", vi) mg</strong></span>
                        }
                    </div>
                    @if (budget.Health.Constraints.MaxSodiumMg is int sodiumLimit)
                    {
                        var sodiumProgress = (Model.ActualSodium, sodiumLimit, true);
                        <partial name="_SodiumProgress" model="sodiumProgress" />
                    }
                </div>
                <img class="dash-nutrition-art" src="~/images/dashboard/handoff/healthy-salad.png"
                     width="477" height="401" alt="" aria-hidden="true" loading="lazy" decoding="async" />
            </div>
        </div>

        <!-- Gợi ý món ăn phù hợp với ngân sách calo còn lại (Standalone grid, không lồng card trong card) -->
        <div class="dash-surface dash-suggestions @(budget.Suspended ? "suggestions-paused" : "")">
            <div class="suggestions-heading">
                <div>
                    <h3 class="h5 fw-bold mb-1"><i class="bi bi-stars text-emerald me-2" aria-hidden="true"></i>Gợi ý món ăn</h3>
                    @if (!budget.Suspended)
                    {
                        <p class="text-muted small mb-0 dash-measure">@Model.SuggestionNote</p>
                    }
                </div>
                <a asp-controller="Food" asp-action="Index" class="dash-btn-outline py-1 px-3 small">
                    <i class="bi bi-grid" aria-hidden="true"></i>
                    <span>Khám phá danh mục món</span>
                </a>
            </div>

            @if (budget.Suspended)
            {
                <div class="dash-suggestion-message d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <p class="small mb-0">Gợi ý món tạm ngừng vì kế hoạch calo đang tạm ngừng.</p>
                    <a asp-controller="Goal" asp-action="Index" class="fw-semibold small text-emerald">Xem đánh giá kế hoạch</a>
                </div>
            }
            else if (Model.SuggestedFoods.Any())
            {
                <div class="row g-3">
                    @foreach (var food in Model.SuggestedFoods)
                    {
                        <div class="col-12 col-sm-6 col-lg-3">
                            <article class="dash-food-card">
                                <partial name="_FoodImage" model="food" />
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <span class="small fw-semibold text-emerald mb-1">
                                        @(food.Category?.Name ?? "Món ăn")
                                    </span>
                                    <h4 class="h6 fw-bold mb-1">
                                        <a asp-controller="Food" asp-action="Details" asp-route-id="@food.Id" class="dash-food-title-link">
                                            @food.Name
                                        </a>
                                    </h4>
                                    <p class="small text-muted mb-3 dash-tabular">@food.ServingSize.ToString("0.##", vi) @food.ServingName</p>

                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-emerald dash-tabular">@food.Calories.ToString("N0", vi) kcal</span>
                                        <a asp-controller="MealLog" asp-action="Index" class="dash-btn-outline py-1 px-2 small" title="Thêm vào bữa ăn">
                                            <i class="bi bi-plus-lg text-emerald"></i>
                                            <span>Thêm</span>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dash-suggestion-message text-center py-3">
                    <i class="bi bi-cup-straw fs-4 d-block text-emerald mb-1"></i>
                    <p class="small text-muted mb-0">Chưa có món gợi ý phù hợp. Bạn có thể tra cứu thêm trong danh mục món.</p>
                </div>
            }
        </div>
    </section>

    <!-- Nhắc nhở an toàn dinh dưỡng -->
    <div class="dash-surface nutrition-reference">
        <i class="bi bi-shield-check text-emerald fs-4 flex-shrink-0" aria-hidden="true"></i>
        <p class="small text-muted mb-0">
            <strong class="text-dark">Thông tin tham khảo.</strong> BMR dùng công thức Mifflin–St Jeor. @GoalPolicy.AdultBmiReference Chỉ số BMI và số liệu calo chỉ dùng để sàng lọc và theo dõi.
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        async function quickAddWater(amount) {
            const actions = document.getElementById('dashWaterActions');
            if (actions.getAttribute('aria-busy') === 'true') return;

            const buttons = actions.querySelectorAll('button');
            const status = document.getElementById('dashWaterStateText');
            actions.setAttribute('aria-busy', 'true');
            buttons.forEach(button => { button.disabled = true; });
            status.classList.remove('text-danger');
            status.textContent = 'Đang ghi lượng nước…';

            try {
                const formData = new FormData(document.getElementById('antiForgeryForm'));
                formData.set('amountMl', amount);
                const response = await fetch('@Url.Action("QuickAddWater", "Dashboard")', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                if (!response.ok) throw new Error('Water log request failed');
                const data = await response.json();
                if (!data.success) throw new Error('Water log response unsuccessful');

                document.getElementById('dashWaterAmount').textContent = data.totalWater.toLocaleString('vi-VN');
                document.getElementById('dashWaterGoal').textContent = data.dailyGoal.toLocaleString('vi-VN') + ' ml';
                document.getElementById('dashWaterBadge').textContent = data.percent + '%';

                const bar = document.getElementById('dashWaterBar');
                bar.parentElement.setAttribute('aria-valuenow', data.percent);
                bar.style.width = data.percent + '%';

                const remaining = Math.max(0, data.dailyGoal - data.totalWater);
                const goalMessage = remaining > 0
                    ? `Còn ${remaining.toLocaleString('vi-VN')} ml để đạt mục tiêu.`
                    : 'Đã đạt mục tiêu nước uống hôm nay.';
                status.textContent = `Đã ghi +${data.added} ml. ${goalMessage}`;
            } catch {
                status.classList.add('text-danger');
                status.textContent = 'Chưa xác nhận được lượt ghi. Hãy kiểm tra Nhật ký nước trước khi ghi lại.';
            } finally {
                buttons.forEach(button => { button.disabled = false; });
                actions.setAttribute('aria-busy', 'false');
            }
        }

        // 2. Macro Doughnut Chart (Chart.js)
        const macroCanvas = document.getElementById('macroDoughnutChart');
        if (typeof Chart !== 'undefined' && !macroCanvas.closest('[hidden]')) {
            const nutrientStyle = getComputedStyle(macroCanvas);
            const pGrams = @Model.ActualProtein.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const cGrams = @Model.ActualCarb.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const fGrams = @Model.ActualFat.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const recP = @Model.RecommendedProteinPercent;
            const recC = @Model.RecommendedCarbPercent;
            const recF = @Model.RecommendedFatPercent;

            const hasIntake = (pGrams + cGrams + fGrams) > 0;

            new Chart(macroCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Chất đạm', 'Tinh bột', 'Chất béo'],
                    datasets: [{
                        data: hasIntake ? [pGrams * 4, cGrams * 4, fGrams * 9] : [recP, recC, recF],
                        backgroundColor: ['--protein', '--carb', '--fat'].map(color => nutrientStyle.getPropertyValue(color).trim()),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: true,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    if (!hasIntake) return ` Tham khảo ${ctx.label}: ${ctx.raw}%`;
                                    return ` ${ctx.label}: ${Math.round(ctx.raw).toLocaleString('vi-VN')} kcal`;
                                }
                            }
                        }
                    }
                }
            });
        }

        const weightCanvas = document.getElementById('weightTrendChart');
        if (weightCanvas && typeof Chart !== 'undefined') {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightChartLabels));
            const weights = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightChartValues));
            const weightPanelStyle = getComputedStyle(weightCanvas);
            const accent = weightPanelStyle.getPropertyValue('--leaf').trim();
            const divider = weightPanelStyle.getPropertyValue('--line').trim();
            const datasets = [{
                label: 'Thực tế',
                data: weights,
                borderColor: accent,
                backgroundColor: accent,
                borderWidth: 2,
                pointRadius: weights.length > 15 ? 2 : 4,
                pointHoverRadius: 5,
                pointHitRadius: 12
            }];
            @if (Model.HasActiveGoal && !budget.Suspended)
            {
                <text>
                datasets.push({
                    label: 'Mục tiêu',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TargetWeightChartValues)),
                    borderColor: '#7b6241',
                    backgroundColor: '#7b6241',
                    borderDash: [5, 5],
                    borderWidth: 1.5,
                    pointRadius: 0
                });
                </text>
            }
            new Chart(weightCanvas, {
                type: 'line',
                data: { labels, datasets },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            display: datasets.length > 1,
                            align: 'end',
                            labels: { boxWidth: 18, boxHeight: 2 }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toLocaleString('vi-VN') + ' kg'
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { autoSkip: true, maxTicksLimit: 5, maxRotation: 0 }
                        },
                        y: {
                            grace: '8%',
                            border: { display: false },
                            grid: { color: divider },
                            ticks: {
                                maxTicksLimit: 5,
                                callback: value => Number(value).toLocaleString('vi-VN') + ' kg'
                            }
                        }
                    }
                }
            });
        }
    </script>
}
