@model NutriTrackAI.Models.ViewModels.MealLogIndexViewModel
@using NutriTrackAI.Models.Enums
@using NutriTrackAI.Models.Entities
@using System.Globalization
@{
    ViewData["Title"] = "Nhật ký Bữa ăn";
    var isToday = Model.SelectedDate.Date == GoalPolicy.Today;
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    var selectedDateText = Model.SelectedDate.ToString("dddd, dd/MM/yyyy", viCulture);
    var selectedDateLabel = char.ToUpper(selectedDateText[0], viCulture) + selectedDateText[1..];
    var remainingLabel = Model.RemainingCalories switch
    {
        > 0 => $"Còn {Model.RemainingCalories.ToString("N0", viCulture)} kcal",
        < 0 => $"Vượt {Math.Abs(Model.RemainingCalories).ToString("N0", viCulture)} kcal",
        _ => Model.UsesMaintenanceReference ? "Đúng mốc duy trì" : "Đúng ngân sách calo"
    };

    var mealSections = new[]
    {
        new { Type = (int)MealType.Breakfast, Name = "Bữa sáng", Icon = "bi-sunrise-fill text-warning", Percent = 25m, TargetCal = (int)Math.Round(Model.DailyCalorieTarget * 0.25m), Log = Model.BreakfastLog },
        new { Type = (int)MealType.Lunch, Name = "Bữa trưa", Icon = "bi-sun-fill text-primary", Percent = 35m, TargetCal = (int)Math.Round(Model.DailyCalorieTarget * 0.35m), Log = Model.LunchLog },
        new { Type = (int)MealType.Dinner, Name = "Bữa tối", Icon = "bi-moon-stars-fill text-indigo", Percent = 30m, TargetCal = (int)Math.Round(Model.DailyCalorieTarget * 0.30m), Log = Model.DinnerLog },
        new { Type = (int)MealType.Snack, Name = "Bữa phụ / Ăn vặt", Icon = "bi-cup-hot-fill text-success", Percent = 10m, TargetCal = (int)Math.Round(Model.DailyCalorieTarget * 0.10m), Log = Model.SnackLog }
    };
}

<div class="container py-4">
    <!-- Header & Date Navigation -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-slate-800 mb-1">
                <i class="bi bi-journal-bookmark-fill text-emerald me-2"></i>Nhật ký Bữa ăn
            </h2>
            <p class="text-muted mb-0">Theo dõi năng lượng và dinh dưỡng của 4 bữa mỗi ngày.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Index" asp-route-date="@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-chevron-left me-1"></i>Hôm trước
            </a>
            
            <form method="get" asp-action="Index" class="d-flex flex-column align-items-center gap-1">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" max="@GoalPolicy.Today.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm rounded-pill text-center fw-semibold text-slate-800 shadow-sm" 
                       data-business-date="mealLogSelectedDate" aria-label="Chọn ngày nhật ký" aria-describedby="mealLogSelectedDate"
                       style="width: 150px;" onchange="this.form.submit()" />
                <time id="mealLogSelectedDate" class="small text-muted" datetime="@Model.SelectedDate.ToString("yyyy-MM-dd")">@selectedDateLabel</time>
            </form>

            @if (!isToday)
            {
                <a asp-action="Index" asp-route-date="@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Hôm sau<i class="bi bi-chevron-right ms-1"></i>
                </a>
                <a asp-action="Index" class="btn btn-emerald-soft btn-sm rounded-pill px-3 fw-semibold">
                    Về hôm nay
                </a>
            }
            else
            {
                <span class="badge bg-emerald-soft text-emerald px-3 py-2 rounded-pill fw-semibold">Hôm nay</span>
            }
        </div>
    </div>

    <!-- Cảnh báo Dị ứng Pending từ lần gửi trước (nếu có) -->
    @if (TempData["PendingAllergyWarning"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 border-danger p-4">
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-exclamation-octagon-fill fs-2 text-danger flex-shrink-0"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading fw-bold mb-1">Cảnh báo Dị ứng Thực phẩm!</h5>
                    <p class="mb-3">@TempData["PendingAllergyWarning"]</p>
                    <form asp-action="AddFood" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="LoggedOn" value="@TempData["PendingDate"]" />
                        <input type="hidden" name="MealType" value="@TempData["PendingMealType"]" />
                        <input type="hidden" name="FoodId" value="@TempData["PendingFoodId"]" />
                        <input type="hidden" name="Servings" value="@TempData["PendingServings"]" />
                        <input type="hidden" name="ConfirmedAllergy" value="true" />
                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold me-2">
                            <i class="bi bi-check-lg me-1"></i>Tôi hiểu rõ và vẫn muốn thêm món này
                        </button>
                        <a asp-action="Index" asp-route-date="@TempData["PendingDate"]" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Cảnh báo Dị ứng trong ngày (nếu đã có món ăn chứa dị ứng) -->
    @if (Model.AllergyAlerts.Any())
    {
        <div class="alert alert-warning rounded-4 shadow-sm mb-4 border-warning">
            <h6 class="fw-bold mb-2 text-warning-emphasis"><i class="bi bi-shield-exclamation me-2"></i>Lưu ý Dị ứng trong thực đơn hôm nay:</h6>
            <ul class="mb-0 ps-3 small text-secondary">
                @foreach (var alert in Model.AllergyAlerts)
                {
                    <li>@alert</li>
                }
            </ul>
        </div>
    }

    <!-- Daily Calorie & Macro Status Cards -->
    <div class="row g-3 mb-4">
        <!-- Calorie Budget Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <span class="text-muted small fw-semibold">@Model.CalorieReferenceLabel</span>
                        <h3 class="fw-bold mb-0 text-slate-800 mt-1">@Model.TotalCalories.ToString("N0", viCulture) <span class="fs-6 fw-normal text-muted">/ @Model.DailyCalorieTarget.ToString("N0", viCulture) kcal</span></h3>
                    </div>
                    <span class="badge @Model.CalorieStatusBadgeBg @(Model.CalorieStatusBadgeBg == "bg-warning" ? "text-dark" : "text-white") px-3 py-2 rounded-pill">
                        @remainingLabel
                    </span>
                </div>

                @{
                    var calPercent = Model.DailyCalorieTarget > 0 ? (int)Math.Min(100, Math.Round((decimal)Model.TotalCalories * 100 / Model.DailyCalorieTarget)) : 0;
                }
                <div class="progress rounded-pill mb-3" style="height: 12px;">
                    <div class="progress-bar @(Model.RemainingCalories > 50 ? "bg-emerald" : (Model.RemainingCalories >= -50 ? "bg-warning" : "bg-danger")) progress-bar-striped progress-bar-animated" role="progressbar" style="width: @calPercent%"></div>
                </div>

                <div class="row text-center pt-2 border-top g-2">
                    <div class="col-4">
                        <small class="text-muted d-block">Đã nạp</small>
                        <span class="fw-bold text-slate-800">@Model.TotalCalories.ToString("N0", viCulture)</span>
                    </div>
                    <div class="col-4 border-start border-end">
                        <small class="text-muted d-block">Vận động đã ghi</small>
                        <span class="fw-bold text-success">@Model.CaloriesBurnedToday.ToString("N0", viCulture)</span>
                        <small class="text-muted d-block">Cộng lại @Model.ExerciseCreditApplied.ToString("N0", viCulture) kcal</small>
                    </div>
                    <div class="col-4">
                        <small class="text-muted d-block">@(Model.UsesMaintenanceReference ? "So với mốc duy trì" : "Còn lại")</small>
                        <span class="fw-bold @Model.CalorieStatusClass">
                            @Model.RemainingCalories.ToString("N0", viCulture)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Macros Breakdown Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <span class="text-muted small fw-semibold mb-3 d-block">Dinh dưỡng đa lượng</span>
                @if (Model.RecommendedMacros is { UnavailableReason: null } macros)
                {
                    <p class="small text-muted">Tham khảo mỗi ngày · Đạm @macros.ProteinGrams.ToString("0.0", viCulture) g · Tinh bột @macros.CarbGrams.ToString("0.0", viCulture) g · Béo @macros.FatGrams.ToString("0.0", viCulture) g</p>
                }
                else if (Model.RecommendedMacros?.UnavailableReason is { } reason)
                {
                    <p class="small text-warning-emphasis">@reason</p>
                }
                
                <div class="row g-3">
                    <!-- Protein -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-4 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-danger"><i class="bi bi-lightning-charge-fill me-1"></i>Chất đạm</span>
                                <span class="small text-muted">@Model.TotalProtein.ToString("F1", viCulture) g</span>
                            </div>
                            <div class="progress rounded-pill mb-1" style="height: 6px;">
                                <div class="progress-bar bg-danger" style="width: 100%"></div>
                            </div>
                            <small class="text-muted">@((Model.TotalProtein * 4).ToString("F0")) kcal</small>
                        </div>
                    </div>

                    <!-- Carbs -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-4 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-primary"><i class="bi bi-disc-fill me-1"></i>Tinh bột</span>
                                <span class="small text-muted">@Model.TotalCarb.ToString("F1", viCulture) g</span>
                            </div>
                            <div class="progress rounded-pill mb-1" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: 100%"></div>
                            </div>
                            <small class="text-muted">@((Model.TotalCarb * 4).ToString("F0")) kcal</small>
                        </div>
                    </div>

                    <!-- Fat -->
                    <div class="col-md-4">
                        <div class="p-3 rounded-4 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-warning-emphasis"><i class="bi bi-droplet-fill me-1"></i>Chất béo</span>
                                <span class="small text-muted">@Model.TotalFat.ToString("F1", viCulture) g</span>
                            </div>
                            <div class="progress rounded-pill mb-1" style="height: 6px;">
                                <div class="progress-bar bg-warning" style="width: 100%"></div>
                            </div>
                            <small class="text-muted">@((Model.TotalFat * 9).ToString("F0")) kcal</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-3 pt-3 border-top small text-muted">
                    <span>Chất xơ: <strong class="text-slate-800">@Model.TotalFiber.ToString("F1", viCulture) g</strong></span>
                    <span>Đường: <strong class="text-slate-800">@Model.TotalSugar.ToString("F1", viCulture) g</strong></span>
                    @if (!Model.DietaryConstraints.MaxSodiumMg.HasValue)
                    {
                        <span>Natri: <strong class="text-slate-800">@Model.TotalSodium.ToString("N0", viCulture) mg</strong></span>
                    }
                </div>
                @if (Model.DietaryConstraints.MaxSodiumMg is int sodiumLimit)
                {
                    var sodiumProgress = (Model.TotalSodium, sodiumLimit, Model.SelectedDate.Date == GoalPolicy.Today);
                    <partial name="_SodiumProgress" model="sodiumProgress" />
                }
            </div>
        </div>
    </div>

    <!-- 4 Meal Cards Section -->
    <div class="row g-4">
        @foreach (var meal in mealSections)
        {
            var details = meal.Log?.Details ?? new List<MealLogDetail>();
            var mealCal = details.Sum(x => x.Calories);

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    <!-- Card Header -->
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @meal.Icon fs-4"></i>
                            <div>
                                <h5 class="fw-bold mb-0 text-slate-800">@meal.Name</h5>
                                @if (!Model.UsesMaintenanceReference)
                                {
                                    <small class="text-muted">Khuyến nghị @meal.Percent% (~@meal.TargetCal.ToString("N0", viCulture) kcal)</small>
                                }
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="fs-5 fw-bold text-emerald">@mealCal.ToString("N0")</span>
                            <small class="text-muted d-block">kcal</small>
                        </div>
                    </div>

                    <!-- Items Body -->
                    <div class="card-body p-0">
                        @if (details.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in details)
                                {
                                    <div class="list-group-item p-3 d-flex align-items-center justify-content-between gap-3 border-bottom">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.Food.ImageUrl))
                                            {
                                                <img src="@item.Food.ImageUrl" alt="@item.Food.Name" class="rounded-3 object-fit-cover shadow-xs" style="width: 50px; height: 50px;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-3 bg-light d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-egg-fried fs-4"></i>
                                                </div>
                                            }
                                            <div>
                                                <h6 class="mb-0 fw-bold text-slate-800">
                                                    <a asp-controller="Food" asp-action="Details" asp-route-id="@item.FoodId" class="text-decoration-none text-slate-800 hover-emerald">
                                                        @item.Food.Name
                                                    </a>
                                                </h6>
                                                <small class="text-muted">
                                                    @item.Servings.ToString("0.##") @item.Food.ServingName • @item.Calories.ToString("N0") kcal
                                                </small>
                                                <div class="small text-secondary mt-1">
                                                    <span class="me-2">Chất đạm: @item.Protein.ToString("F1", viCulture) g</span>
                                                    <span class="me-2">Tinh bột: @item.Carb.ToString("F1", viCulture) g</span>
                                                    <span>Chất béo: @item.Fat.ToString("F1", viCulture) g</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-1">
                                            <!-- Edit Servings Button -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" 
                                                    data-bs-toggle="modal" data-bs-target="#editModal-@item.Id" title="Sửa lượng ăn">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <!-- Delete Detail Form -->
                                            <form asp-action="DeleteDetail" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa món này khỏi bữa ăn?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="detailId" value="@item.Id" />
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Edit Modal for Item -->
                                    <div class="modal fade" id="editModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-sm">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h6 class="modal-title fw-bold">Chỉnh sửa định lượng</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="UpdateServings" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="DetailId" value="@item.Id" />
                                                    <input type="hidden" name="LoggedOn" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                    <div class="modal-body py-3">
                                                        <p class="small text-muted mb-2">Món: <strong>@item.Food.Name</strong></p>
                                                        <label class="form-label small fw-semibold">Khẩu phần ăn (@item.Food.ServingName):</label>
                                                        <div class="input-group input-group-sm">
                                                            <input type="number" step="0.1" min="0.1" max="5000" name="Servings" value="@item.Servings" class="form-control rounded-3" required />
                                                            <span class="input-group-text">@item.Food.ServingName</span>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn btn-sm btn-emerald text-white rounded-pill px-3">Cập nhật</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-egg fs-2 d-block text-secondary opacity-50 mb-2"></i>
                                <small>Chưa có món nào trong @meal.Name.ToLower().</small>
                            </div>
                        }
                    </div>

                    <!-- Card Footer: Add Food Button -->
                    <div class="card-footer bg-light border-0 p-3 text-center">
                        <button type="button" class="btn btn-emerald-soft btn-sm rounded-pill px-3 w-100 fw-semibold"
                                onclick="openAddFoodModal(@meal.Type, '@meal.Name')">
                            <i class="bi bi-plus-circle me-1"></i>Thêm món vào @meal.Name
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Thêm Món Vào Bữa Ăn -->
<div class="modal fade" id="addFoodModal" tabindex="-1" aria-labelledby="addFoodModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <h5 class="modal-title fw-bold text-slate-800" id="addFoodModalLabel">
                    <i class="bi bi-plus-circle-fill text-emerald me-2"></i>Thêm món vào <span id="modalMealTitleText">Bữa ăn</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Tabs: Tìm kiếm & Món yêu thích -->
                <ul class="nav nav-pills mb-3" id="addFoodTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-3 py-1 fw-semibold small" id="search-tab" data-bs-toggle="pill" data-bs-target="#tab-search" type="button" role="tab">
                            <i class="bi bi-search me-1"></i>Tìm kiếm món
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-3 py-1 fw-semibold small" id="fav-tab" data-bs-toggle="pill" data-bs-target="#tab-fav" type="button" role="tab">
                            <i class="bi bi-heart-fill me-1 text-danger"></i>Món yêu thích (@Model.FavoriteFoods.Count)
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="addFoodTabsContent">
                    <!-- Tab Tìm kiếm -->
                    <div class="tab-pane fade show active" id="tab-search" role="tabpanel">
                        <div class="position-relative mb-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" id="foodSearchInput" class="form-control border-start-0" placeholder="Nhập tên món ăn (ví dụ: Phở bò, Ức gà, Cơm tấm...)" autocomplete="off">
                            </div>
                            <div id="foodSearchResults" class="list-group position-absolute w-100 shadow-lg rounded-3 mt-1 d-none overflow-auto" style="max-height: 250px; z-index: 1055;"></div>
                        </div>
                    </div>

                    <!-- Tab Món yêu thích -->
                    <div class="tab-pane fade" id="tab-fav" role="tabpanel">
                        @if (Model.FavoriteFoods.Any())
                        {
                            <div class="list-group list-group-flush border rounded-3 mb-3 overflow-auto" style="max-height: 250px;">
                                @foreach (var fav in Model.FavoriteFoods)
                                {
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"
                                            onclick='selectFoodItem({ id: @fav.Id, name: "@fav.Name", calories: @fav.Calories, protein: @fav.Protein, carbs: @fav.Carb, fat: @fav.Fat, servingSize: @fav.ServingSize, servingUnit: "@fav.ServingName" })'>
                                        <div>
                                            <div class="fw-bold text-slate-800">@fav.Name</div>
                                            <small class="text-muted">@fav.ServingSize @fav.ServingName • @fav.Calories kcal</small>
                                        </div>
                                        <span class="badge bg-emerald-soft text-emerald rounded-pill px-3 py-1">Chọn</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted border rounded-3 mb-3">
                                <small>Bạn chưa đánh dấu món yêu thích nào. Hãy khám phá <a asp-controller="Food" asp-action="Index">Danh mục Món ăn</a> để thêm nhé!</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Form Submit Add Food -->
                <form id="addFoodForm" asp-action="AddFood" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LoggedOn" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="MealType" id="modalMealTypeInput" value="1" />
                    <input type="hidden" name="FoodId" id="selectedFoodId" required />
                    <input type="hidden" name="ConfirmedAllergy" id="ackAllergyInput" value="false" />

                    <!-- Selected Food Card -->
                    <div id="selectedFoodPreview" class="p-3 rounded-4 border bg-light mb-3 d-none">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold mb-1 text-slate-800" id="selectedFoodName">Tên món</h6>
                                <p class="small text-muted mb-0" id="selectedFoodStandardInfo">Chuẩn: 100g = 150 kcal</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="clearSelectedFood()">Đổi món</button>
                        </div>
                    </div>

                    <!-- Allergy Warning Box (Hidden by default) -->
                    <div id="allergyWarningAlert" class="alert alert-danger rounded-4 d-none mb-3">
                        <div class="d-flex gap-2">
                            <i class="bi bi-exclamation-octagon-fill fs-4 text-danger"></i>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Cảnh báo Dị ứng Thực phẩm!</h6>
                                <p class="small mb-2" id="allergyWarningMessage">Món này có thể chứa chất gây dị ứng trùng với hồ sơ của bạn.</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ackAllergyCheckbox" onchange="document.getElementById('ackAllergyInput').value = this.checked;">
                                    <label class="form-check-label small fw-semibold text-danger" for="ackAllergyCheckbox">
                                        Tôi đã hiểu rõ rủi ro dị ứng và vẫn muốn thêm món này.
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Servings Input -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-slate-800">Số lượng / Khẩu phần ăn thực tế:</label>
                            <div class="input-group">
                                <input type="number" step="0.1" min="0.1" max="5000" name="Servings" id="modalServingsInput" class="form-control" placeholder="Ví dụ: 100" value="100" required />
                                <span class="input-group-text" id="modalServingUnit">khẩu phần</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-slate-800">Ước tính nạp vào:</label>
                            <div class="p-2 border rounded-3 bg-white text-emerald fw-bold text-center" id="scaledNutritionPreview">
                                0 kcal
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" id="btnSubmitAddFood" class="btn btn-success text-white rounded-pill px-4 fw-semibold shadow-sm" disabled>
                            <i class="bi bi-plus-lg me-1"></i>Thêm vào bữa ăn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedFood = null;
        let foodSearchDebounce = null;

        function openAddFoodModal(mealType, mealTitle) {
            document.getElementById('modalMealTypeInput').value = mealType;
            document.getElementById('modalMealTitleText').innerText = mealTitle;
            clearSelectedFood();
            const modal = new bootstrap.Modal(document.getElementById('addFoodModal'));
            modal.show();
        }

        function clearSelectedFood() {
            selectedFood = null;
            document.getElementById('selectedFoodId').value = '';
            document.getElementById('foodSearchInput').value = '';
            document.getElementById('selectedFoodPreview').classList.add('d-none');
            document.getElementById('allergyWarningAlert').classList.add('d-none');
            document.getElementById('ackAllergyCheckbox').checked = false;
            document.getElementById('ackAllergyInput').value = 'false';
            document.getElementById('btnSubmitAddFood').disabled = true;
            document.getElementById('scaledNutritionPreview').innerText = '0 kcal';
        }

        // Live Food Autocomplete Search
        document.getElementById('foodSearchInput').addEventListener('input', function () {
            const query = this.value.trim();
            const resultsDiv = document.getElementById('foodSearchResults');

            clearTimeout(foodSearchDebounce);
            if (query.length < 2) {
                resultsDiv.classList.add('d-none');
                resultsDiv.innerHTML = '';
                return;
            }

            foodSearchDebounce = setTimeout(async () => {
                try {
                    const response = await fetch(`/Food/SearchJson?query=${encodeURIComponent(query)}`);
                    const foods = await response.json();

                    if (!foods || foods.length === 0) {
                        resultsDiv.innerHTML = '<div class="list-group-item text-muted small p-3">Không tìm thấy món ăn phù hợp.</div>';
                    } else {
                        resultsDiv.innerHTML = foods.map(f => {
                            const unit = f.servingUnit || f.servingName || 'phần';
                            const carbs = (f.carbs !== undefined) ? f.carbs : ((f.carb !== undefined) ? f.carb : 0);
                            return `
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3" onclick='selectFoodItem(${JSON.stringify(f).replace(/'/g, "&#39;")})'>
                                <div>
                                    <div class="fw-bold text-slate-800">${f.name}</div>
                                    <small class="text-muted">${f.servingSize} ${unit} • ${f.calories} kcal · Chất đạm ${f.protein} g · Tinh bột ${carbs} g · Chất béo ${f.fat} g</small>
                                </div>
                                <span class="badge bg-emerald-soft text-emerald rounded-pill px-3 py-1">Chọn</span>
                            </button>
                            `;
                        }).join('');
                    }
                    resultsDiv.classList.remove('d-none');
                } catch (e) {
                    console.error('Error fetching food autocomplete:', e);
                }
            }, 300);
        });

        // Select Food Item
        async function selectFoodItem(food) {
            selectedFood = food;
            const unit = food.servingUnit || food.servingName || 'phần';
            const carbs = (food.carbs !== undefined) ? food.carbs : ((food.carb !== undefined) ? food.carb : 0);

            document.getElementById('selectedFoodId').value = food.id;
            document.getElementById('selectedFoodName').innerText = food.name;
            document.getElementById('selectedFoodStandardInfo').innerText = 
                `Khẩu phần chuẩn: ${food.servingSize} ${unit} = ${food.calories} kcal · Chất đạm ${food.protein} g · Tinh bột ${carbs} g · Chất béo ${food.fat} g`;
            document.getElementById('modalServingUnit').innerText = unit;
            document.getElementById('modalServingsInput').value = food.servingSize;
            
            document.getElementById('selectedFoodPreview').classList.remove('d-none');
            document.getElementById('foodSearchResults').classList.add('d-none');
            document.getElementById('foodSearchInput').value = '';

            // Check allergy
            try {
                const response = await fetch(`/MealLog/CheckFoodAllergy?foodId=${food.id}`);
                const data = await response.json();
                const allergyAlert = document.getElementById('allergyWarningAlert');
                if (data.hasAllergy) {
                    document.getElementById('allergyWarningMessage').innerText = 
                        `Món '${data.foodName}' có chứa [${data.allergensFound}] trùng với hồ sơ dị ứng của bạn!`;
                    allergyAlert.classList.remove('d-none');
                } else {
                    allergyAlert.classList.add('d-none');
                }
            } catch (err) {
                console.error('Error checking allergy:', err);
            }

            updateScaledNutrition();
            const submitBtn = document.getElementById('btnSubmitAddFood');
            submitBtn.disabled = false;
        }

        // Calculate scaled nutrition preview
        document.getElementById('modalServingsInput').addEventListener('input', updateScaledNutrition);

        function updateScaledNutrition() {
            if (!selectedFood) return;
            const servings = parseFloat(document.getElementById('modalServingsInput').value) || 0;
            const ratio = selectedFood.servingSize > 0 ? (servings / selectedFood.servingSize) : 0;
            const cal = Math.round(selectedFood.calories * ratio);
            const p = (selectedFood.protein * ratio).toFixed(1);
            const carbs = (selectedFood.carbs !== undefined) ? selectedFood.carbs : ((selectedFood.carb !== undefined) ? selectedFood.carb : 0);
            const c = (carbs * ratio).toFixed(1);
            const f = (selectedFood.fat * ratio).toFixed(1);

            document.getElementById('scaledNutritionPreview').innerText = 
                `Khoảng ${cal} kcal · Chất đạm ${p} g · Tinh bột ${c} g · Chất béo ${f} g`;
        }

        // Close search results when clicking outside
        document.addEventListener('click', function (e) {
            const resultsDiv = document.getElementById('foodSearchResults');
            const searchInput = document.getElementById('foodSearchInput');
            if (resultsDiv && !resultsDiv.contains(e.target) && e.target !== searchInput) {
                resultsDiv.classList.add('d-none');
            }
        });
    </script>
}
