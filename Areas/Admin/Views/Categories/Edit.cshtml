@model AdminCategoryEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Nhóm Thực phẩm";
}

<div class="container-fluid px-0" style="max-width: 800px;">
    <div class="mb-4">
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-light border rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-pencil-square text-emerald me-2"></i>Chỉnh sửa Nhóm Thực phẩm
        </h2>
        <p class="text-muted mb-0">Cập nhật thông tin nhóm món ăn #@Model.Id: @Model.Name</p>
    </div>

    <div class="card-custom p-4">
        <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên Nhóm Thực phẩm <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label fw-semibold">Mã Slug <span class="text-danger">*</span></label>
                <input asp-for="Slug" class="form-control font-monospace" />
                <span class="form-text small text-muted">Dùng định danh nội bộ hệ thống, viết thường không dấu nối nhau bằng gạch ngang.</span>
                <span asp-validation-for="Slug" class="text-danger small d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Mô tả ngắn</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                <label class="form-check-label fw-semibold" for="isActiveSwitch">Kích hoạt hiển thị nhóm này</label>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                <button type="submit" class="btn btn-emerald rounded-pill px-4">
                    <i class="bi bi-check2-circle me-1"></i>Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
