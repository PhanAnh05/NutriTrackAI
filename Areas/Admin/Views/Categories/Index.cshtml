@model List<FoodCategory>
@{
    ViewData["Title"] = "Quản lý Nhóm Thực phẩm";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tags-fill text-emerald me-2"></i>Nhóm Thực phẩm
            </h2>
            <p class="text-muted mb-0">Quản lý danh mục phân loại dinh dưỡng cho toàn bộ món ăn trong hệ thống.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-emerald rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i>Thêm Nhóm mới
            </a>
        </div>
    </div>

    <div class="card-custom p-4 mb-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-tag fs-1 d-block mb-2 opacity-50"></i>
                <h5>Chưa có nhóm thực phẩm nào</h5>
                <p class="small">Hãy tạo nhóm thực phẩm mới để bắt đầu phân loại món ăn.</p>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-emerald btn-sm rounded-pill mt-2">
                    Thêm nhóm ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th>Tên nhóm & Slug</th>
                            <th>Mô tả</th>
                            <th class="text-center">Số món ăn</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@cat.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 bg-light border p-2 text-center" style="width: 44px; height: 44px;">
                                            <i class="bi bi-tag-fill fs-5 text-emerald"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-slate-900">@cat.Name</div>
                                            <span class="badge bg-light text-muted border font-monospace">@cat.Slug</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)
                                </td>
                                <td class="text-center">
                                    <a asp-area="Admin" asp-controller="Foods" asp-action="Index" asp-route-categoryId="@cat.Id" class="badge bg-light text-dark text-decoration-none border px-2 py-1">
                                        @(cat.Foods?.Count ?? 0) món
                                    </a>
                                </td>
                                <td class="text-center">
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash me-1"></i>Đang ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Edit -->
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Toggle Active -->
                                        <form asp-area="Admin" asp-controller="Categories" asp-action="ToggleActive" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-3"
                                                    title="@(cat.IsActive ? "Ẩn nhóm" : "Kích hoạt nhóm")">
                                                <i class="bi @(cat.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa nhóm \'@cat.Name\'? Nhóm chỉ xóa được khi không có món ăn nào.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa nhóm"
                                                    @(cat.Foods != null && cat.Foods.Any() ? "disabled" : "")>
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
