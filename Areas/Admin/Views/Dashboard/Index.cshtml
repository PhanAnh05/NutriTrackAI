@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Thống kê";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 text-emerald me-2"></i>Tổng quan Hệ thống
            </h2>
            <p class="text-muted mb-0">Thống kê hoạt động, người dùng và dữ liệu dinh dưỡng toàn nền tảng NutriTrackAI.</p>
        </div>
        <div>
            <span class="badge bg-emerald-soft text-emerald px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-shield-check me-1"></i>Hệ thống hoạt động ổn định
            </span>
        </div>
    </div>

    <!-- Cards Row 1: KPI Metrics -->
    <div class="row g-3 mb-4">
        <!-- Người dùng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold small">TỔNG NGƯỜI DÙNG</span>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold mb-2">@Model.TotalUsers</div>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="badge bg-success-subtle text-success fw-medium">+@Model.NewUsersToday hôm nay</span>
                    <span class="text-muted">+@Model.NewUsersThisMonth tháng này</span>
                </div>
            </div>
        </div>

        <!-- Chatbot AI -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold small">LƯỢT DÙNG CHATBOT AI</span>
                    <div class="rounded-3 bg-emerald-soft text-emerald p-2">
                        <i class="bi bi-robot fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold mb-2">@Model.TotalChatMessages <span class="fs-6 fw-normal text-muted">tin nhắn</span></div>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="badge bg-emerald-soft text-emerald fw-medium">@Model.TotalChatSessions phiên chat</span>
                    <span class="text-muted">Gemini 2.5 Flash</span>
                </div>
            </div>
        </div>

        <!-- Món ăn trong hệ thống -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold small">KHO MÓN ĂN & NHÓM</span>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-egg-fried fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold mb-2">@Model.TotalFoods <span class="fs-6 fw-normal text-muted">món</span></div>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-medium">@Model.TotalCategories nhóm thực phẩm</span>
                    <span class="text-muted">Đã kiểm duyệt</span>
                </div>
            </div>
        </div>

        <!-- Lượt ghi nhận bữa ăn -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold small">LƯỢT GHI NHẬN BỮA ĂN</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold mb-2">@Model.TotalMealLogsLogged</div>
                <div class="small text-muted">
                    <i class="bi bi-activity text-info me-1"></i>Tương tác dinh dưỡng hàng ngày
                </div>
            </div>
        </div>
    </div>

    <!-- Charts & Analytics Row -->
    <div class="row g-4 mb-4">
        <!-- Goal Distribution Chart -->
        <div class="col-12 col-lg-5">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0">Tỷ lệ Mục tiêu Người dùng</h5>
                        <small class="text-muted">Phân loại theo Giảm cân, Tăng cân và Duy trì</small>
                    </div>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-pie-chart-fill me-1"></i>Tỷ trọng
                    </span>
                </div>

                <div class="d-flex justify-content-center align-items-center my-3" style="min-height: 250px;">
                    <canvas id="goalDistributionChart" style="max-height: 240px;"></canvas>
                </div>

                <div class="row text-center pt-2 border-top g-2">
                    <div class="col-4">
                        <div class="text-danger fw-bold fs-5">@Model.GoalTypeLoseCount</div>
                        <small class="text-muted">Giảm cân</small>
                    </div>
                    <div class="col-4">
                        <div class="text-primary fw-bold fs-5">@Model.GoalTypeGainCount</div>
                        <small class="text-muted">Tăng cân</small>
                    </div>
                    <div class="col-4">
                        <div class="text-success fw-bold fs-5">@Model.GoalTypeMaintainCount</div>
                        <small class="text-muted">Duy trì</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 Logged Foods -->
        <div class="col-12 col-lg-7">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0">Top 10 Món Ăn Được Ghi Nhận Nhiều Nhất</h5>
                        <small class="text-muted">Thống kê từ dữ liệu nhật ký bữa ăn của người dùng</small>
                    </div>
                    <a asp-area="Admin" asp-controller="Foods" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                        Xem tất cả món <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (!Model.TopFoods.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                        <span>Chưa có dữ liệu nhật ký món ăn nào được ghi nhận.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">#</th>
                                    <th>Món ăn</th>
                                    <th>Nhóm</th>
                                    <th class="text-center">Số lượt ghi</th>
                                    <th class="text-end">Tổng Calo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopFoods.Count; i++)
                                {
                                    var food = Model.TopFoods[i];
                                    <tr>
                                        <td class="fw-bold @(i < 3 ? "text-emerald" : "text-muted")">@(i + 1)</td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Foods" asp-action="Edit" asp-route-id="@food.FoodId" class="text-decoration-none fw-semibold text-slate-800 hover-emerald">
                                                @food.FoodName
                                            </a>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border">@food.CategoryName</span></td>
                                        <td class="text-center fw-semibold">
                                            <span class="badge bg-emerald-soft text-emerald px-2 py-1">@food.LogCount lượt</span>
                                        </td>
                                        <td class="text-end text-muted small">@food.TotalCaloriesLogged.ToString("N0") kcal</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Users Table -->
    <div class="card-custom p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0">Người Dùng Mới Đăng Ký Gần Đây</h5>
                <small class="text-muted">Danh sách tài khoản tham gia hệ thống mới nhất</small>
            </div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm btn-emerald rounded-pill px-3">
                <i class="bi bi-people me-1"></i>Quản lý Người dùng
            </a>
        </div>

        @if (!Model.RecentUsers.Any())
        {
            <div class="text-center py-4 text-muted">Chưa có người dùng nào.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Họ và Tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Ngày đăng ký</th>
                            <th>Đăng nhập cuối</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>@user.FullName
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.RoleName == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">User</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger text-white"><i class="bi bi-lock-fill me-1"></i>Bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">@(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Security & Privacy Disclaimer Card -->
    <div class="card-custom bg-slate-100 p-3 border-start border-4 border-info">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-shield-lock-fill text-info fs-4"></i>
            <div class="small text-secondary">
                <strong>Chính sách Bảo mật Quyền Riêng tư (Section 5 GEMINI.md):</strong> Bảng điều khiển quản trị chỉ hiển thị số liệu thống kê tổng hợp và siêu dữ liệu tài khoản cơ bản. Quản trị viên tuyệt đối không được phép xem nội dung chi tiết nhật ký bữa ăn, cân nặng cá nhân hay lịch sử hội thoại AI của từng người dùng.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('goalDistributionChart').getContext('2d');
            const loseCount = @Model.GoalTypeLoseCount;
            const gainCount = @Model.GoalTypeGainCount;
            const maintainCount = @Model.GoalTypeMaintainCount;

            const total = loseCount + gainCount + maintainCount;

            if (total === 0) {
                // Mock display if empty
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Chưa thiết lập'],
                        datasets: [{
                            data: [1],
                            backgroundColor: ['#e2e8f0']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            } else {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Giảm cân', 'Tăng cân', 'Duy trì'],
                        datasets: [{
                            data: [loseCount, gainCount, maintainCount],
                            backgroundColor: ['#ef4444', '#3b82f6', '#10b981'],
                            hoverOffset: 4,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 15,
                                    font: { family: "'Plus Jakarta Sans', sans-serif" }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
