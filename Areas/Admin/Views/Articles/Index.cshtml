@model List<Article>
@{
    ViewData["Title"] = "Quản lý Bài viết & FAQ (RAG Knowledge Base)";
    string? search = ViewBag.Search as string;
    ArticleType? type = ViewBag.Type as ArticleType?;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-richtext text-emerald me-2"></i>Bài viết & FAQ (RAG Knowledge Base)
            </h2>
            <p class="text-muted mb-0">Quản trị nội dung kiến thức dinh dưỡng, giải đáp thắc mắc và làm kho dữ liệu truy xuất RAG cho Chatbot AI.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Articles" asp-action="Create" class="btn btn-emerald rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i>Thêm Bài viết / FAQ Mới
            </a>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card-custom p-3 mb-4">
        <form method="get" asp-area="Admin" asp-controller="Articles" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tiêu đề hoặc nội dung..." />
                </div>
            </div>

            <div class="col-6 col-md-4">
                <select name="type" class="form-select">
                    <option value="">-- Tất cả phân loại --</option>
                    <option value="@ArticleType.Faq" selected="@(type == ArticleType.Faq)">Câu hỏi thường gặp (FAQ)</option>
                    <option value="@ArticleType.Article" selected="@(type == ArticleType.Article)">Bài viết kiến thức (Article)</option>
                    <option value="@ArticleType.Disclaimer" selected="@(type == ArticleType.Disclaimer)">Cảnh báo & Tuyên bố y tế (Disclaimer)</option>
                </select>
            </div>

            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-emerald w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-area="Admin" asp-controller="Articles" asp-action="Index" class="btn btn-light border rounded-3" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card-custom p-4 mb-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-50"></i>
                <h5>Không tìm thấy bài viết hoặc FAQ nào</h5>
                <p class="small">Thử tìm kiếm từ khóa khác hoặc tạo thêm nội dung mới.</p>
                <a asp-area="Admin" asp-controller="Articles" asp-action="Create" class="btn btn-emerald btn-sm rounded-pill mt-2">
                    Thêm bài viết ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th>Tiêu đề & Nội dung tóm tắt</th>
                            <th>Phân loại</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Cập nhật cuối</th>
                            <th class="text-end" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@article.Id</td>
                                <td>
                                    <div class="fw-bold text-slate-900">@article.Title</div>
                                    <div class="text-muted small text-truncate" style="max-width: 450px;">
                                        @article.Body
                                    </div>
                                </td>
                                <td>
                                    @switch (article.Type)
                                    {
                                        case ArticleType.Faq:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">FAQ</span>
                                            break;
                                        case ArticleType.Article:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Kiến thức</span>
                                            break;
                                        case ArticleType.Disclaimer:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Disclaimer</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (article.IsPublished)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Xuất bản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash me-1"></i>Nháp / Ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@article.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Edit -->
                                        <a asp-area="Admin" asp-controller="Articles" asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Toggle Publish -->
                                        <form asp-area="Admin" asp-controller="Articles" asp-action="TogglePublish" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@article.Id" />
                                            <button type="submit" class="btn btn-sm @(article.IsPublished ? "btn-outline-warning" : "btn-outline-success") rounded-3"
                                                    title="@(article.IsPublished ? "Chuyển thành bản nháp" : "Xuất bản bài viết")">
                                                <i class="bi @(article.IsPublished ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form asp-area="Admin" asp-controller="Articles" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa bài viết \'@article.Title\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@article.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
