@model AdminFoodEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Món Ăn";
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <div class="mb-4">
        <a asp-area="Admin" asp-controller="Foods" asp-action="Index" class="btn btn-sm btn-light border rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh mục
        </a>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-pencil-square text-emerald me-2"></i>Chỉnh sửa Món Ăn #@Model.Id
        </h2>
        <p class="text-muted mb-0">Cập nhật thông tin và thành phần dinh dưỡng của món <strong>@Model.Name</strong>.</p>
    </div>

    <div class="card-custom p-4">
        <form asp-area="Admin" asp-controller="Foods" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

            <!-- Basic Info -->
            <h5 class="fw-bold text-slate-800 mb-3 pb-2 border-bottom">
                <i class="bi bi-info-circle text-emerald me-2"></i>Thông tin Cơ bản
            </h5>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-7">
                    <label asp-for="Name" class="form-label fw-semibold">Tên Món Ăn <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-5">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Nhóm Thực phẩm <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">-- Chọn nhóm thực phẩm --</option>
                        @foreach (var cat in Model.AvailableCategories)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="ServingName" class="form-label fw-semibold">Tên Khẩu phần Chuẩn <span class="text-danger">*</span></label>
                    <input asp-for="ServingName" class="form-control" />
                    <span asp-validation-for="ServingName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="ServingSize" class="form-label fw-semibold">Trọng lượng Chuẩn (g / ml) <span class="text-danger">*</span></label>
                    <input asp-for="ServingSize" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="ServingSize" class="text-danger small"></span>
                </div>
            </div>

            <!-- Nutritional Info -->
            <h5 class="fw-bold text-slate-800 mb-3 pb-2 border-bottom mt-4">
                <i class="bi bi-pie-chart text-emerald me-2"></i>Thành phần Dinh dưỡng (cho 1 khẩu phần chuẩn)
            </h5>

            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3">
                    <label asp-for="Calories" class="form-label fw-semibold text-danger">Calo (kcal) <span class="text-danger">*</span></label>
                    <input asp-for="Calories" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Calories" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Protein" class="form-label fw-semibold">Protein (g)</label>
                    <input asp-for="Protein" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Protein" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Carb" class="form-label fw-semibold">Carbohydrate (g)</label>
                    <input asp-for="Carb" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Carb" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Fat" class="form-label fw-semibold">Chất béo Fat (g)</label>
                    <input asp-for="Fat" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Fat" class="text-danger small"></span>
                </div>

                <div class="col-6 col-md-4">
                    <label asp-for="Fiber" class="form-label fw-semibold">Chất xơ Fiber (g)</label>
                    <input asp-for="Fiber" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Fiber" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-4">
                    <label asp-for="Sugar" class="form-label fw-semibold">Đường Sugar (g)</label>
                    <input asp-for="Sugar" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Sugar" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Sodium" class="form-label fw-semibold">Natri Sodium (mg)</label>
                    <input asp-for="Sodium" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Sodium" class="text-danger small"></span>
                </div>
            </div>

            <!-- Ingredients & Safety -->
            <h5 class="fw-bold text-slate-800 mb-3 pb-2 border-bottom mt-4">
                <i class="bi bi-shield-exclamation text-emerald me-2"></i>Nguyên liệu & Cảnh báo Sức khỏe
            </h5>

            <div class="mb-3">
                <label asp-for="Ingredients" class="form-label fw-semibold">Nguyên liệu chính</label>
                <textarea asp-for="Ingredients" class="form-control" rows="2"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="AllergenNotes" class="form-label fw-semibold text-danger">Chất gây dị ứng (nếu có)</label>
                    <input asp-for="AllergenNotes" class="form-control" />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="HealthWarning" class="form-label fw-semibold text-warning-emphasis">Cảnh báo sức khỏe</label>
                    <input asp-for="HealthWarning" class="form-control" />
                </div>
            </div>

            <!-- Image & Flags -->
            <h5 class="fw-bold text-slate-800 mb-3 pb-2 border-bottom mt-4">
                <i class="bi bi-image text-emerald me-2"></i>Hình ảnh & Cấu hình
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-3 text-center">
                    <label class="form-label fw-semibold d-block">Ảnh hiện tại</label>
                    <div class="rounded-3 border overflow-hidden d-inline-block bg-light" style="width: 100px; height: 100px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/food-placeholder.png';" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 col-md-9">
                    <div class="mb-2">
                        <label asp-for="ImageFile" class="form-label fw-semibold">Tải lên ảnh mới (nếu muốn thay đổi)</label>
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <span asp-validation-for="ImageFile" class="text-danger small d-block"></span>
                    </div>
                    <div>
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Hoặc Đường dẫn ảnh (URL)</label>
                        <input asp-for="ImageUrl" class="form-control" />
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex gap-4 flex-wrap pt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsVegetarian" class="form-check-input" type="checkbox" id="isVegSwitch">
                            <label class="form-check-label fw-semibold" for="isVegSwitch">Món ăn chay (Vegetarian)</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="IsHidden" class="form-check-input" type="checkbox" id="isHiddenSwitch">
                            <label class="form-check-label fw-semibold text-danger" for="isHiddenSwitch">Ẩn món này khỏi danh mục người dùng</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-area="Admin" asp-controller="Foods" asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                <button type="submit" class="btn btn-emerald rounded-pill px-4">
                    <i class="bi bi-check2-circle me-1"></i>Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
