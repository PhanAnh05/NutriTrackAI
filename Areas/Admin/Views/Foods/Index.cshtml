@model List<Food>
@{
    ViewData["Title"] = "Quản lý Món ăn";
    var categories = ViewBag.Categories as List<FoodCategory> ?? new();
    string? search = ViewBag.Search as string;
    int? categoryId = ViewBag.CategoryId as int?;
    bool? showHidden = ViewBag.ShowHidden as bool?;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-egg-fried text-emerald me-2"></i>Quản lý Món ăn & Dinh dưỡng
            </h2>
            <p class="text-muted mb-0">Cơ sở dữ liệu thực phẩm, năng lượng, thành phần vĩ lượng và cảnh báo dị ứng.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Foods" asp-action="Create" class="btn btn-emerald rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i>Thêm Món mới
            </a>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card-custom p-3 mb-4">
        <form method="get" asp-area="Admin" asp-controller="Foods" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên món hoặc nguyên liệu..." />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả nhóm thực phẩm --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select name="showHidden" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="false" selected="@(showHidden == false)">Đang hiển thị</option>
                    <option value="true" selected="@(showHidden == true)">Đang bị ẩn</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-emerald w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-area="Admin" asp-controller="Foods" asp-action="Index" class="btn btn-light border rounded-3" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Food Catalog Table -->
    <div class="card-custom p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">Tìm thấy <strong>@Model.Count</strong> món ăn</span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-egg fs-1 d-block mb-2 opacity-50"></i>
                <h5>Không tìm thấy món ăn nào</h5>
                <p class="small">Thử tìm kiếm với từ khóa khác hoặc bỏ các bộ lọc.</p>
                <a asp-area="Admin" asp-controller="Foods" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mt-2">
                    Xóa bộ lọc
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th style="width: 60px;">Ảnh</th>
                            <th>Tên món ăn & Khẩu phần</th>
                            <th>Nhóm</th>
                            <th class="text-end">Năng lượng</th>
                            <th class="text-center">Macro (P / C / F)</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var food in Model)
                        {
                            <tr class="@(food.IsHidden ? "table-light opacity-75" : "")">
                                <td class="text-muted fw-semibold">#@food.Id</td>
                                <td>
                                    <div class="rounded-3 overflow-hidden bg-light border d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        @if (!string.IsNullOrEmpty(food.ImageUrl))
                                        {
                                            <img src="@food.ImageUrl" alt="@food.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/food-placeholder.png';" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-egg-fried text-muted fs-4"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-900">
                                        @food.Name
                                        @if (food.IsVegetarian)
                                        {
                                            <span class="badge bg-success-subtle text-success ms-1 small" title="Món chay">
                                                <i class="bi bi-flower1"></i> Chay
                                            </span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        @food.ServingName (@food.ServingSize.ToString("0.#")g)
                                        @if (!string.IsNullOrEmpty(food.AllergenNotes))
                                        {
                                            <span class="text-danger ms-1" title="Dị ứng: @food.AllergenNotes">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @(food.Category?.Name ?? "—")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-slate-900">
                                    @food.Calories.ToString("0.#") <span class="fw-normal text-muted small">kcal</span>
                                </td>
                                <td class="text-center small">
                                    <span class="text-danger fw-semibold" title="Protein">@food.Protein.ToString("0.#")P</span> / 
                                    <span class="text-warning-emphasis fw-semibold" title="Carb">@food.Carb.ToString("0.#")C</span> / 
                                    <span class="text-info-emphasis fw-semibold" title="Fat">@food.Fat.ToString("0.#")F</span>
                                </td>
                                <td class="text-center">
                                    @if (!food.IsHidden)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash me-1"></i>Đang ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Edit -->
                                        <a asp-area="Admin" asp-controller="Foods" asp-action="Edit" asp-route-id="@food.Id" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Toggle Hidden -->
                                        <form asp-area="Admin" asp-controller="Foods" asp-action="ToggleHidden" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@food.Id" />
                                            <button type="submit" class="btn btn-sm @(food.IsHidden ? "btn-outline-success" : "btn-outline-warning") rounded-3"
                                                    title="@(food.IsHidden ? "Hiện món ăn" : "Ẩn món ăn")">
                                                <i class="bi @(food.IsHidden ? "bi-eye" : "bi-eye-slash")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form asp-area="Admin" asp-controller="Foods" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa món \'@food.Name\'? Nếu đã có người dùng ghi nhật ký, món sẽ tự động được chuyển sang trạng thái Ẩn để bảo toàn dữ liệu.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@food.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa món">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
